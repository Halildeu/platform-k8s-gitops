{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://acik.com/schemas/faz25-p5-evidence-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verdict",
    "artifactKind",
    "startedAt",
    "completedAt",
    "github",
    "binding",
    "lineage",
    "children"
  ],
  "properties": {
    "schemaVersion": { "const": "faz25-p5-evidence-manifest-v1" },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "artifactKind": { "enum": ["acceptance", "diagnostic"] },
    "startedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "completedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "runId", "runAttempt", "eventName", "ref", "sha"],
      "properties": {
        "repository": { "const": "Halildeu/platform-k8s-gitops" },
        "workflow": { "const": "Verify Faz 25 P5 authenticated product surface" },
        "runId": { "type": "string", "pattern": "^[0-9]+$" },
        "runAttempt": { "type": "string", "pattern": "^[0-9]+$" },
        "eventName": { "const": "workflow_dispatch" },
        "ref": { "const": "refs/heads/main" },
        "sha": { "$ref": "#/definitions/gitSha" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalMainAtStart",
        "canonicalMainAtEnd",
        "prePostSameSession",
        "browserPodBuildInfoMatched",
        "browserIngressLogMatched",
        "browserAssetPodMatched",
        "continuousRouteWatchPassed",
        "freshWithinRun",
        "strictChildSchemas",
        "sensitiveValueScanPassed"
      ],
      "properties": {
        "canonicalMainAtStart": { "type": "boolean" },
        "canonicalMainAtEnd": { "type": "boolean" },
        "prePostSameSession": { "type": "boolean" },
        "browserPodBuildInfoMatched": { "type": "boolean" },
        "browserIngressLogMatched": { "type": "boolean" },
        "browserAssetPodMatched": { "type": "boolean" },
        "continuousRouteWatchPassed": { "type": "boolean" },
        "freshWithinRun": { "type": "boolean" },
        "strictChildSchemas": { "type": "boolean" },
        "sensitiveValueScanPassed": { "type": "boolean" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSha", "frontendDigest", "buildRunId"],
      "properties": {
        "sourceSha": { "const": "125d2d85f139cb2b8fcfee27eb6a0affbb4bcc2b" },
        "frontendDigest": {
          "const": "sha256:c000e5bc58352c48305e8a67c1b019abf8a3cf2856d95423434d3bb42d423a9f"
        },
        "buildRunId": { "const": "29483736629" }
      }
    },
    "children": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "schemaVersion"],
        "properties": {
          "kind": { "enum": ["browser", "lineage-pre", "lineage-post", "route-watch"] },
          "path": { "type": "string", "pattern": "^[a-z0-9-]+\\.json$" },
          "sha256": { "$ref": "#/definitions/sha256" },
          "schemaVersion": {
            "enum": [
              "faz25-p5-authenticated-product-surface-v5",
              "faz25-p5-frontend-lineage-v2",
              "faz25-p5-continuous-route-watch-v2"
            ]
          }
        },
        "oneOf": [
          {
            "properties": {
              "kind": { "const": "browser" },
              "path": { "const": "browser-report.json" },
              "schemaVersion": { "const": "faz25-p5-authenticated-product-surface-v5" }
            }
          },
          {
            "properties": {
              "kind": { "const": "lineage-pre" },
              "path": { "const": "lineage-pre.json" },
              "schemaVersion": { "const": "faz25-p5-frontend-lineage-v2" }
            }
          },
          {
            "properties": {
              "kind": { "const": "lineage-post" },
              "path": { "const": "lineage-post.json" },
              "schemaVersion": { "const": "faz25-p5-frontend-lineage-v2" }
            }
          },
          {
            "properties": {
              "kind": { "const": "route-watch" },
              "path": { "const": "route-watch.json" },
              "schemaVersion": { "const": "faz25-p5-continuous-route-watch-v2" }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "PASS" } } },
      "then": {
        "properties": {
          "artifactKind": { "const": "acceptance" },
          "binding": {
            "type": "object",
            "properties": {
              "canonicalMainAtStart": { "const": true },
              "canonicalMainAtEnd": { "const": true },
              "prePostSameSession": { "const": true },
              "browserPodBuildInfoMatched": { "const": true },
              "browserIngressLogMatched": { "const": true },
              "browserAssetPodMatched": { "const": true },
              "continuousRouteWatchPassed": { "const": true },
              "freshWithinRun": { "const": true },
              "strictChildSchemas": { "const": true },
              "sensitiveValueScanPassed": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "FAIL" } } },
      "then": { "properties": { "artifactKind": { "const": "diagnostic" } } }
    },
    {
      "properties": {
        "children": {
          "allOf": [
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": { "kind": { "const": "browser" } }
              }
            },
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": { "kind": { "const": "lineage-pre" } }
              }
            },
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": { "kind": { "const": "lineage-post" } }
              }
            },
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": { "kind": { "const": "route-watch" } }
              }
            }
          ]
        }
      }
    }
  ],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
