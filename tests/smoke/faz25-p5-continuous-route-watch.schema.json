{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://acik.com/schemas/faz25-p5-continuous-route-watch-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verdict",
    "failureReason",
    "startedAt",
    "observedAt",
    "target",
    "intervalMilliseconds",
    "sampleCount",
    "violationCount",
    "eventWatchMode",
    "eventWatchEstablished",
    "eventWatchResourceVersion",
    "eventWatchErrorSha256",
    "finalResourceVersion",
    "eventCount",
    "browserAssetPathCount",
    "browserAssetPathsSha256",
    "routeProjectionSha256s"
  ],
  "properties": {
    "schemaVersion": { "const": "faz25-p5-continuous-route-watch-v2" },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "failureReason": {
      "enum": [
        "",
        "route-policy-or-collection-failure",
        "route-projection-changed",
        "missing-list-resource-version",
        "route-event-watch-terminated",
        "route-event-watch-stderr-observed",
        "route-event-watch-error",
        "route-event-observed",
        "route-resource-version-changed",
        "browser-route-path-evidence-missing",
        "browser-asset-route-policy-failure",
        "insufficient-continuous-samples"
      ]
    },
    "startedAt": { "$ref": "#/definitions/timestamp" },
    "observedAt": { "$ref": "#/definitions/timestamp" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "host", "canonicalIngress"],
      "properties": {
        "context": { "const": "k3d-test" },
        "host": { "const": "testai.acik.com" },
        "canonicalIngress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "name", "uid"],
          "properties": {
            "namespace": { "const": "platform-test" },
            "name": { "const": "platform" },
            "uid": { "$ref": "#/definitions/uuid" }
          }
        }
      }
    },
    "intervalMilliseconds": { "const": 250 },
    "sampleCount": { "type": "integer", "minimum": 0 },
    "violationCount": { "type": "integer", "minimum": 0 },
    "eventWatchMode": { "const": "KUBERNETES_RESOURCE_VERSION_STREAM" },
    "eventWatchEstablished": { "type": "boolean" },
    "eventWatchResourceVersion": {
      "type": "string",
      "pattern": "^$|^[0-9]+$"
    },
    "eventWatchErrorSha256": {
      "type": "string",
      "pattern": "^$|^[0-9a-f]{64}$"
    },
    "finalResourceVersion": {
      "type": "string",
      "pattern": "^$|^[0-9]+$"
    },
    "eventCount": { "type": "integer", "minimum": 0 },
    "browserAssetPathCount": { "type": "integer", "minimum": 0 },
    "browserAssetPathsSha256": {
      "type": "string",
      "pattern": "^$|^[0-9a-f]{64}$"
    },
    "routeProjectionSha256s": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/sha256" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "PASS" } } },
      "then": {
        "properties": {
          "failureReason": { "const": "" },
          "sampleCount": { "type": "integer", "minimum": 2 },
          "violationCount": { "const": 0 },
          "eventWatchEstablished": { "const": true },
          "eventWatchResourceVersion": { "pattern": "^[0-9]+$" },
          "eventWatchErrorSha256": { "const": "" },
          "finalResourceVersion": { "pattern": "^[0-9]+$" },
          "eventCount": { "const": 0 },
          "browserAssetPathCount": { "type": "integer", "minimum": 1 },
          "browserAssetPathsSha256": { "pattern": "^[0-9a-f]{64}$" },
          "routeProjectionSha256s": { "minItems": 1, "maxItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "FAIL" } } },
      "then": {
        "properties": {
          "failureReason": { "not": { "const": "" } },
          "violationCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "failureReason": { "const": "route-event-watch-stderr-observed" }
        }
      },
      "then": {
        "properties": {
          "eventWatchErrorSha256": { "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  ],
  "definitions": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
