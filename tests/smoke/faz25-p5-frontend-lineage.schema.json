{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://acik.com/schemas/faz25-p5-frontend-lineage-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "observedAt",
    "cluster",
    "deployment",
    "replicaSet",
    "pods",
    "lineage",
    "route"
  ],
  "properties": {
    "schemaVersion": { "const": "faz25-p5-frontend-lineage-v2" },
    "phase": { "enum": ["pre", "post"] },
    "observedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "serverSha256", "caSha256", "kubeSystemNamespaceUid"],
      "properties": {
        "context": { "const": "k3d-test" },
        "serverSha256": {
          "const": "72f91f37ac4b9d16dad5b443afdabaca0a2644f4b91cd91189a0be0550d17d29"
        },
        "caSha256": {
          "const": "ad4b1f16b77cc270d3b0f4d1d6b8495d49b90c29ea8c78e1ed8dec36c9a8af96"
        },
        "kubeSystemNamespaceUid": {
          "const": "0a7f11d1-53d6-452f-bdac-3669507af073"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "name",
        "uid",
        "resourceVersion",
        "generation",
        "observedGeneration",
        "rolloutRevision",
        "desiredReplicas",
        "image"
      ],
      "properties": {
        "namespace": { "const": "platform-test" },
        "name": { "const": "frontend" },
        "uid": { "$ref": "#/definitions/uuid" },
        "resourceVersion": { "type": "string", "pattern": "^[0-9]+$" },
        "generation": { "type": "integer", "minimum": 1 },
        "observedGeneration": { "type": "integer", "minimum": 1 },
        "rolloutRevision": { "type": "string", "pattern": "^[0-9]+$" },
        "desiredReplicas": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "string",
          "pattern": "^ghcr\\.io/halildeu/platform-web-frontend-testai:sha-bc33397@sha256:aab566968dc0406fe5ca81143a3eac378fc8a877a00f0ab88e0f048603949f6d$"
        }
      }
    },
    "replicaSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uid", "rolloutRevision"],
      "properties": {
        "name": { "type": "string", "pattern": "^frontend-[a-z0-9]+$" },
        "uid": { "$ref": "#/definitions/uuid" },
        "rolloutRevision": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "pods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readyCount", "uids", "imageIds"],
      "properties": {
        "readyCount": { "type": "integer", "minimum": 1 },
        "uids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/uuid" }
        },
        "imageIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^.*@sha256:aab566968dc0406fe5ca81143a3eac378fc8a877a00f0ab88e0f048603949f6d$"
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha",
        "expectedDigest",
        "observedDigest",
        "buildRunId",
        "buildRunUrl",
        "buildArtifactId",
        "buildArtifactName",
        "buildArtifactDigest",
        "buildArtifactSizeInBytes",
        "buildArtifactEvidenceClass",
        "buildImageContractUrl",
        "buildImageContractSha256",
        "buildImageContractSchemaVersion",
        "expectedBuildImage",
        "buildAttestationStatus",
        "buildAttestationBoundary"
      ],
      "properties": {
        "sourceSha": { "const": "bc33397de0a1eb097a1e045396c178d66c1bed95" },
        "expectedDigest": {
          "const": "sha256:aab566968dc0406fe5ca81143a3eac378fc8a877a00f0ab88e0f048603949f6d"
        },
        "observedDigest": {
          "const": "sha256:aab566968dc0406fe5ca81143a3eac378fc8a877a00f0ab88e0f048603949f6d"
        },
        "buildRunId": { "const": "29487972095" },
        "buildRunUrl": {
          "const": "https://github.com/Halildeu/platform-web/actions/runs/29487972095"
        },
        "buildArtifactId": { "const": "8371284324" },
        "buildArtifactName": {
          "const": "Halildeu~platform-web~34268X.dockerbuild"
        },
        "buildArtifactDigest": {
          "const": "sha256:190c27aeb082b9040c856647766b2e02dc46738019458ed9994116364ebd584a"
        },
        "buildArtifactSizeInBytes": { "const": 108553 },
        "buildArtifactEvidenceClass": { "const": "METADATA_ONLY_NON_TERMINAL" },
        "buildImageContractUrl": {
          "const": "https://raw.githubusercontent.com/Halildeu/platform-web/bc33397de0a1eb097a1e045396c178d66c1bed95/scripts/deploy/build-image-contract.json"
        },
        "buildImageContractSha256": {
          "const": "00e2ff3f6862eb2d39c2df21d3adc3f885c6fd2346bc1dc0a9da66b08b1cfad6"
        },
        "buildImageContractSchemaVersion": {
          "const": "acik.platform.web-build-image/v1"
        },
        "expectedBuildImage": {
          "const": "ghcr.io/halildeu/platform-web-frontend-testai:sha-bc33397"
        },
        "buildAttestationStatus": { "const": "NOT_PUBLISHED" },
        "buildAttestationBoundary": {
          "const": "Cross-repository artifact content is not fetched because no least-privilege token is configured; artifact metadata is non-terminal and no SLSA attestation is claimed. Terminal browser-to-image binding is the same-session Ingress, Service, EndpointSlice, Ready Pod UID and imageID chain plus exact build-info source SHA."
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "ingress",
        "service",
        "endpointSlices",
        "podBuildInfoSha256s",
        "browserRequestBinding",
        "browserAssetBinding"
      ],
      "properties": {
        "host": { "const": "testai.acik.com" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "uid",
            "className",
            "path",
            "serviceName",
            "servicePort",
            "matchingRoutes"
          ],
          "properties": {
            "name": { "const": "platform" },
            "uid": { "$ref": "#/definitions/uuid" },
            "className": { "const": "nginx" },
            "path": { "const": "/" },
            "serviceName": { "const": "frontend" },
            "servicePort": { "const": 80 },
            "matchingRoutes": {
              "type": "array",
              "minItems": 6,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requestPath",
                  "namespace",
                  "ingressName",
                  "ingressUid",
                  "rulePath",
                  "pathType",
                  "serviceName",
                  "servicePort"
                ],
                "properties": {
                  "requestPath": {
                    "enum": [
                      "/",
                      "/home",
                      "/login",
                      "/admin/ats",
                      "/admin/interview-evidence",
                      "/build-info.json"
                    ]
                  },
                  "namespace": { "const": "platform-test" },
                  "ingressName": { "const": "platform" },
                  "ingressUid": { "$ref": "#/definitions/uuid" },
                  "rulePath": { "const": "/" },
                  "pathType": { "const": "Prefix" },
                  "serviceName": { "const": "frontend" },
                  "servicePort": { "const": 80 }
                }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "uid", "type", "clusterIp", "selector"],
          "properties": {
            "name": { "const": "frontend" },
            "uid": { "$ref": "#/definitions/uuid" },
            "type": { "const": "ClusterIP" },
            "clusterIp": { "type": "string", "minLength": 1 },
            "selector": {
              "const": { "app.kubernetes.io/name": "frontend" }
            }
          }
        },
        "endpointSlices": {
          "type": "object",
          "additionalProperties": false,
          "required": ["names", "uids", "readyPodUids", "readyPodNetworkBindings"],
          "properties": {
            "names": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^frontend-[a-z0-9]+$" }
            },
            "uids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/uuid" }
            },
            "readyPodUids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/uuid" }
            },
            "readyPodNetworkBindings": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["podUid", "addresses"],
                "properties": {
                  "podUid": { "$ref": "#/definitions/uuid" },
                  "addresses": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "$ref": "#/definitions/ipAddress" }
                  }
                }
              }
            }
          }
        },
        "podBuildInfoSha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/sha256" }
        },
        "browserRequestBinding": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": { "status": { "const": "PRE_BROWSER" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "probeId",
                "controllerNamespace",
                "controllerPodName",
                "controllerPodUid",
                "upstreamPodAddress",
                "logLineSha256"
              ],
              "properties": {
                "status": { "const": "BOUND" },
                "probeId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
                "controllerNamespace": { "type": "string", "minLength": 1 },
                "controllerPodName": { "type": "string", "minLength": 1 },
                "controllerPodUid": { "$ref": "#/definitions/uuid" },
                "upstreamPodAddress": { "$ref": "#/definitions/ipAddress" },
                "logLineSha256": { "$ref": "#/definitions/sha256" }
              }
            }
          ]
        },
        "browserAssetBinding": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": { "status": { "const": "PRE_BROWSER" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "browserAssetEvidenceSha256",
                "assetCount",
                "podCount",
                "podAssetBindings"
              ],
              "properties": {
                "status": { "const": "BOUND" },
                "browserAssetEvidenceSha256": { "$ref": "#/definitions/sha256" },
                "assetCount": { "type": "integer", "minimum": 1 },
                "podCount": { "type": "integer", "minimum": 1 },
                "podAssetBindings": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["podUid", "path", "bodySha256"],
                    "properties": {
                      "podUid": { "$ref": "#/definitions/uuid" },
                      "path": {
                        "type": "string",
                        "pattern": "^/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.(js|mjs|css)$"
                      },
                      "bodySha256": { "$ref": "#/definitions/sha256" }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "pre" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "route": {
            "properties": {
              "browserRequestBinding": {
                "properties": { "status": { "const": "PRE_BROWSER" } }
              },
              "browserAssetBinding": {
                "properties": { "status": { "const": "PRE_BROWSER" } }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "post" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "route": {
            "properties": {
              "browserRequestBinding": {
                "properties": { "status": { "const": "BOUND" } }
              },
              "browserAssetBinding": {
                "properties": { "status": { "const": "BOUND" } }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ipAddress": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.){3}(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})$"
        },
        {
          "pattern": "^(?!.*:::)(?:[0-9A-Fa-f]{0,4}:){2,7}[0-9A-Fa-f]{0,4}$"
        }
      ]
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
