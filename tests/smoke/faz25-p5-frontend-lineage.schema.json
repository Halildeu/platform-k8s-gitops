{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://acik.com/schemas/faz25-p5-frontend-lineage-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "observedAt",
    "cluster",
    "deployment",
    "replicaSet",
    "pods",
    "lineage"
  ],
  "properties": {
    "schemaVersion": { "const": "faz25-p5-frontend-lineage-v1" },
    "phase": { "enum": ["pre", "post"] },
    "observedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "serverSha256", "caSha256", "kubeSystemNamespaceUid"],
      "properties": {
        "context": { "const": "k3d-test" },
        "serverSha256": {
          "const": "72f91f37ac4b9d16dad5b443afdabaca0a2644f4b91cd91189a0be0550d17d29"
        },
        "caSha256": {
          "const": "ad4b1f16b77cc270d3b0f4d1d6b8495d49b90c29ea8c78e1ed8dec36c9a8af96"
        },
        "kubeSystemNamespaceUid": {
          "const": "0a7f11d1-53d6-452f-bdac-3669507af073"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "name",
        "uid",
        "resourceVersion",
        "generation",
        "observedGeneration",
        "rolloutRevision",
        "desiredReplicas",
        "image"
      ],
      "properties": {
        "namespace": { "const": "platform-test" },
        "name": { "const": "frontend" },
        "uid": { "$ref": "#/definitions/uuid" },
        "resourceVersion": { "type": "string", "pattern": "^[0-9]+$" },
        "generation": { "type": "integer", "minimum": 1 },
        "observedGeneration": { "type": "integer", "minimum": 1 },
        "rolloutRevision": { "type": "string", "pattern": "^[0-9]+$" },
        "desiredReplicas": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "string",
          "pattern": "^ghcr\\.io/halildeu/platform-web-frontend-testai:sha-7a764fe@sha256:a5c7444b55203ac752fe664bc86c2bb4217c9bbf4b7598493e7a0543c1321c5e$"
        }
      }
    },
    "replicaSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uid", "rolloutRevision"],
      "properties": {
        "name": { "type": "string", "pattern": "^frontend-[a-z0-9]+$" },
        "uid": { "$ref": "#/definitions/uuid" },
        "rolloutRevision": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "pods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readyCount", "uids", "imageIds"],
      "properties": {
        "readyCount": { "type": "integer", "minimum": 1 },
        "uids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/uuid" }
        },
        "imageIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^.*@sha256:a5c7444b55203ac752fe664bc86c2bb4217c9bbf4b7598493e7a0543c1321c5e$"
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha",
        "expectedDigest",
        "observedDigest",
        "buildRunId",
        "buildRunUrl",
        "buildArtifactId",
        "buildArtifactName",
        "buildArtifactDigest",
        "buildArtifactSizeInBytes",
        "buildProvenanceReceiptSha256",
        "slsaProvenanceDigest"
      ],
      "properties": {
        "sourceSha": { "const": "7a764fe91deed655a83f44af7bc15d97481ee29d" },
        "expectedDigest": {
          "const": "sha256:a5c7444b55203ac752fe664bc86c2bb4217c9bbf4b7598493e7a0543c1321c5e"
        },
        "observedDigest": {
          "const": "sha256:a5c7444b55203ac752fe664bc86c2bb4217c9bbf4b7598493e7a0543c1321c5e"
        },
        "buildRunId": { "const": "29444176456" },
        "buildRunUrl": {
          "const": "https://github.com/Halildeu/platform-web/actions/runs/29444176456"
        },
        "buildArtifactId": { "const": "8354811686" },
        "buildArtifactName": {
          "const": "Halildeu~platform-web~M3MVH6.dockerbuild"
        },
        "buildArtifactDigest": {
          "const": "sha256:28efa00e47891ecb5b0f5aa5a58c05c8bcb6a37ccc9b8d4004e649318cc39b4e"
        },
        "buildArtifactSizeInBytes": { "const": 109522 },
        "buildProvenanceReceiptSha256": {
          "const": "579fbd6dbca964d9bbc18305025cb070c7583a476fdcf54390e88594882a4ccf"
        },
        "slsaProvenanceDigest": {
          "const": "sha256:0ad8176f5411ebbad7e791f39faebfdc4782b5b2a367cb05c778a8b1278dbbf1"
        }
      }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
