{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://acik.com/schemas/faz25-p5-frontend-lineage-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "observedAt",
    "cluster",
    "deployment",
    "replicaSet",
    "pods",
    "lineage"
  ],
  "properties": {
    "schemaVersion": { "const": "faz25-p5-frontend-lineage-v1" },
    "phase": { "enum": ["pre", "post"] },
    "observedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "serverSha256", "caSha256", "kubeSystemNamespaceUid"],
      "properties": {
        "context": { "const": "k3d-test" },
        "serverSha256": {
          "const": "72f91f37ac4b9d16dad5b443afdabaca0a2644f4b91cd91189a0be0550d17d29"
        },
        "caSha256": {
          "const": "ad4b1f16b77cc270d3b0f4d1d6b8495d49b90c29ea8c78e1ed8dec36c9a8af96"
        },
        "kubeSystemNamespaceUid": {
          "const": "0a7f11d1-53d6-452f-bdac-3669507af073"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "name",
        "uid",
        "resourceVersion",
        "generation",
        "observedGeneration",
        "rolloutRevision",
        "desiredReplicas",
        "image"
      ],
      "properties": {
        "namespace": { "const": "platform-test" },
        "name": { "const": "frontend" },
        "uid": { "$ref": "#/definitions/uuid" },
        "resourceVersion": { "type": "string", "pattern": "^[0-9]+$" },
        "generation": { "type": "integer", "minimum": 1 },
        "observedGeneration": { "type": "integer", "minimum": 1 },
        "rolloutRevision": { "type": "string", "pattern": "^[0-9]+$" },
        "desiredReplicas": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "string",
          "pattern": "^ghcr\\.io/halildeu/platform-web-frontend-testai:sha-90768ed@sha256:6bdbeeaa1870c34a3c6fe230a2f63ba050f48151ee4174a91b072677d69709f6$"
        }
      }
    },
    "replicaSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uid", "rolloutRevision"],
      "properties": {
        "name": { "type": "string", "pattern": "^frontend-[a-z0-9]+$" },
        "uid": { "$ref": "#/definitions/uuid" },
        "rolloutRevision": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "pods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readyCount", "uids", "imageIds"],
      "properties": {
        "readyCount": { "type": "integer", "minimum": 1 },
        "uids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/uuid" }
        },
        "imageIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^.*@sha256:6bdbeeaa1870c34a3c6fe230a2f63ba050f48151ee4174a91b072677d69709f6$"
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha",
        "expectedDigest",
        "observedDigest",
        "buildRunId",
        "buildRunUrl",
        "buildArtifactId",
        "buildArtifactName",
        "buildArtifactDigest",
        "buildArtifactSizeInBytes",
        "buildProvenanceReceiptSha256",
        "slsaProvenanceDigest"
      ],
      "properties": {
        "sourceSha": { "const": "90768ed318ebfa547d2b3137aa317168f9c726d7" },
        "expectedDigest": {
          "const": "sha256:6bdbeeaa1870c34a3c6fe230a2f63ba050f48151ee4174a91b072677d69709f6"
        },
        "observedDigest": {
          "const": "sha256:6bdbeeaa1870c34a3c6fe230a2f63ba050f48151ee4174a91b072677d69709f6"
        },
        "buildRunId": { "const": "29451703189" },
        "buildRunUrl": {
          "const": "https://github.com/Halildeu/platform-web/actions/runs/29451703189"
        },
        "buildArtifactId": { "const": "8357836615" },
        "buildArtifactName": {
          "const": "Halildeu~platform-web~XWOTK5.dockerbuild"
        },
        "buildArtifactDigest": {
          "const": "sha256:4d571d1bc48c63902a11958da33205539085f59549a810f8c827b2d9a6192a56"
        },
        "buildArtifactSizeInBytes": { "const": 108583 },
        "buildProvenanceReceiptSha256": {
          "const": "bb61a7f1f453b733f721156cbc3f4666813f667164609192d73c40260b7d7d0f"
        },
        "slsaProvenanceDigest": {
          "const": "sha256:6fd32c43a78f33b60225b638efd1929e86f40e38f5c58707c818ff19f1fb46d2"
        }
      }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
