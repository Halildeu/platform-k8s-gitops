{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://acik.com/schemas/faz25-p5-authenticated-product-surface-v4.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verdict",
    "startedAt",
    "observedAt",
    "target",
    "github",
    "authentication",
    "lineage"
  ],
  "properties": {
    "schemaVersion": { "const": "faz25-p5-authenticated-product-surface-v4" },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "startedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "observedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "target": { "const": "https://testai.acik.com" },
    "github": { "$ref": "#/definitions/github" },
    "authentication": { "$ref": "#/definitions/authentication" },
    "lineage": { "$ref": "#/definitions/lineage" },
    "authz": { "$ref": "#/definitions/authz" },
    "discovery": { "$ref": "#/definitions/discovery" },
    "hub": { "$ref": "#/definitions/hub" },
    "product": { "$ref": "#/definitions/product" },
    "responsive": { "$ref": "#/definitions/responsive" },
    "accessibility": { "$ref": "#/definitions/accessibility" },
    "runtime": { "$ref": "#/definitions/runtime" },
    "failedTestStatus": { "type": "string", "pattern": "^[A-Za-z]+$" }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "PASS" } } },
      "then": {
        "required": [
          "authz",
          "discovery",
          "hub",
          "product",
          "responsive",
          "accessibility",
          "runtime"
        ],
        "not": {
          "type": "object",
          "properties": { "failedTestStatus": { "type": "string" } },
          "required": ["failedTestStatus"]
        },
        "properties": {
          "authentication": {
            "allOf": [
              { "$ref": "#/definitions/authentication" },
              {
                "type": "object",
                "properties": {
                  "browserFlow": { "const": "KEYCLOAK_AUTHORIZATION_CODE_PKCE" },
                  "issuerMatched": { "const": true },
                  "authorizeEndpointObserved": { "const": true },
                  "pkceS256Observed": { "const": true },
                  "authorizationCodeCallbackObserved": { "const": true },
                  "callbackOriginMatched": { "const": true },
                  "codeExchangeObserved": { "const": true },
                  "codeVerifierObserved": { "const": true },
                  "stateCorrelationMatched": { "const": true },
                  "codeCorrelationMatched": { "const": true },
                  "pkceChallengeMatched": { "const": true },
                  "tokenResponseSuccessful": { "const": true },
                  "oauthParametersCleared": { "const": true },
                  "loginBlockingViolationCount": { "const": 0 }
                }
              }
            ]
          },
          "authz": {
            "allOf": [
              { "$ref": "#/definitions/authz" },
              {
                "type": "object",
                "properties": {
                  "userIdMatched": { "const": true },
                  "subscriberIdMatched": { "const": true },
                  "superAdminFalse": { "const": true },
                  "exactRolesMatched": { "const": true },
                  "exactModulesMatched": { "const": true },
                  "exactAllowedModulesMatched": { "const": true },
                  "exactPermissionsMatched": { "const": true },
                  "manageGrantAbsent": { "const": true },
                  "exactViewOnlySnapshotMatched": { "const": true }
                }
              }
            ]
          },
          "lineage": {
            "allOf": [
              { "$ref": "#/definitions/lineage" },
              {
                "type": "object",
                "properties": {
                  "expectedSourceSha": {
                    "const": "90768ed318ebfa547d2b3137aa317168f9c726d7"
                  },
                  "observedSourceSha": {
                    "const": "90768ed318ebfa547d2b3137aa317168f9c726d7"
                  },
                  "expectedFrontendDigest": {
                    "const": "sha256:6bdbeeaa1870c34a3c6fe230a2f63ba050f48151ee4174a91b072677d69709f6"
                  },
                  "liveFrontendDigest": {
                    "const": "sha256:6bdbeeaa1870c34a3c6fe230a2f63ba050f48151ee4174a91b072677d69709f6"
                  }
                }
              }
            ]
          },
          "discovery": {
            "allOf": [
              { "$ref": "#/definitions/discovery" },
              {
                "type": "object",
                "properties": {
                  "desktopHomePath": { "const": "/home" },
                  "desktopSidebarVisible": { "const": true },
                  "desktopSidebarHref": { "const": "/admin/ats" },
                  "desktopSearchQuery": { "const": "mülakat" },
                  "desktopSearchResultVisible": { "const": true },
                  "desktopHubPath": { "const": "/admin/ats" },
                  "desktopHubRendered": { "const": true },
                  "desktopLaunchPath": { "const": "/admin/interview-evidence" },
                  "desktopRemoteConsoleRendered": { "const": true },
                  "mobileViewportWidth": { "const": 390 },
                  "mobileHomePath": { "const": "/home" },
                  "mobileMenuOpened": { "const": true },
                  "mobileHrSectionOpened": { "const": true },
                  "mobileAtsProductHubActionVisible": { "const": true },
                  "mobileHubPath": { "const": "/admin/ats" },
                  "mobileHubRendered": { "const": true },
                  "mobileLaunchPath": { "const": "/admin/interview-evidence" },
                  "mobileRemoteConsoleRendered": { "const": true }
                }
              }
            ]
          },
          "hub": {
            "allOf": [
              { "$ref": "#/definitions/hub" },
              {
                "type": "object",
                "properties": {
                  "path": { "const": "/admin/ats" },
                  "rendered": { "const": true },
                  "runtimeReady": { "const": true },
                  "capabilityIds": {
                    "const": [
                      "interview-evidence-workspace",
                      "candidate-cv-pdf-import",
                      "candidate-review-and-appeal",
                      "citation-backed-coaching",
                      "fairness-audit",
                      "quality-of-hire",
                      "skills-evidence",
                      "media-integrity",
                      "agentic-screening"
                    ]
                  },
                  "targetRoleIds": {
                    "const": [
                      "candidate",
                      "recruiter",
                      "hiring_manager",
                      "interviewer",
                      "auditor",
                      "admin"
                    ]
                  },
                  "visibleCapabilityCount": { "const": 9 },
                  "candidateFilterVisible": { "const": true },
                  "candidateBoundaryVisible": { "const": true },
                  "cvImportMode": { "const": "OWNER_GATED" },
                  "cvImportInteractiveControlCount": { "const": 0 },
                  "fileUploadControlCount": { "const": 0 },
                  "liveLaunchHref": { "const": "/admin/interview-evidence" },
                  "productBoundaryVisible": { "const": true }
                }
              }
            ]
          },
          "product": {
            "allOf": [
              { "$ref": "#/definitions/product" },
              {
                "type": "object",
                "properties": {
                  "finalPath": { "const": "/admin/interview-evidence" },
                  "profileIds": {
                    "const": [
                      "deployment-profile-MANAGED",
                      "deployment-profile-DEDICATED",
                      "deployment-profile-BYO_REGION",
                      "deployment-profile-SOVEREIGN_ON_PREM"
                    ]
                  },
                  "gateIds": {
                    "const": [
                      "deployment-gate-SUPPLY_CHAIN",
                      "deployment-gate-PROFILE_RENDER",
                      "deployment-gate-IDENTITY",
                      "deployment-gate-EGRESS",
                      "deployment-gate-SECRET_ROTATION",
                      "deployment-gate-BACKUP_RESTORE",
                      "deployment-gate-UPGRADE_ROLLBACK",
                      "deployment-gate-AUDIT_EXPORT"
                    ]
                  },
                  "gateOwnerZeroCount": { "const": 8 },
                  "ownerAcceptance": { "const": "0/8" },
                  "readinessPercentagePresent": { "const": false },
                  "verifierAction": { "const": "UNAVAILABLE" },
                  "releaseAction": { "const": "UNAVAILABLE" },
                  "interactiveControlIds": {
                    "const": [
                      "deployment-profile-MANAGED",
                      "deployment-profile-DEDICATED",
                      "deployment-profile-BYO_REGION",
                      "deployment-profile-SOVEREIGN_ON_PREM",
                      "deployment-evidence-scroll-region"
                    ]
                  }
                }
              }
            ]
          },
          "responsive": {
            "allOf": [
              { "$ref": "#/definitions/responsive" },
              {
                "type": "object",
                "properties": {
                  "viewportWidth": { "const": 390 },
                  "hubRootOverflowPx": { "type": "number", "maximum": 1 },
                  "hubOverflowPx": { "type": "number", "maximum": 1 },
                  "rootOverflowPx": { "type": "number", "maximum": 1 },
                  "consoleOverflowPx": { "type": "number", "maximum": 1 },
                  "evidenceTableKeyboardScrollable": { "const": true }
                }
              }
            ]
          },
          "accessibility": {
            "allOf": [
              { "$ref": "#/definitions/accessibility" },
              {
                "type": "object",
                "properties": {
                  "loginBlockingViolationCount": { "const": 0 },
                  "hubBlockingViolationCount": { "const": 0 },
                  "productBlockingViolationCount": { "const": 0 },
                  "blockingViolationCount": { "const": 0 },
                  "violations": { "type": "array", "maxItems": 0 }
                }
              }
            ]
          },
          "runtime": {
            "allOf": [
              { "$ref": "#/definitions/runtime" },
              {
                "type": "object",
                "properties": { "uncaughtPageErrorCount": { "const": 0 } }
              }
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "runId", "runAttempt", "eventName", "ref", "sha"],
      "properties": {
        "repository": { "const": "Halildeu/platform-k8s-gitops" },
        "workflow": { "const": "Verify Faz 25 P5 authenticated product surface" },
        "runId": { "type": "string", "pattern": "^[0-9]+$" },
        "runAttempt": { "type": "string", "pattern": "^[0-9]+$" },
        "eventName": { "const": "workflow_dispatch" },
        "ref": { "const": "refs/heads/main" },
        "sha": { "$ref": "#/definitions/gitSha" }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browserFlow",
        "namedPersona",
        "applicationWindowUsed",
        "issuerMatched",
        "authorizeEndpointObserved",
        "pkceS256Observed",
        "authorizationCodeCallbackObserved",
        "callbackOriginMatched",
        "codeExchangeObserved",
        "codeVerifierObserved",
        "stateCorrelationMatched",
        "codeCorrelationMatched",
        "pkceChallengeMatched",
        "tokenResponseSuccessful",
        "oauthParametersCleared",
        "loginBlockingViolationCount"
      ],
      "properties": {
        "browserFlow": { "enum": ["KEYCLOAK_AUTHORIZATION_CODE_PKCE", "UNVERIFIED"] },
        "namedPersona": { "const": "p5-readiness-viewer" },
        "applicationWindowUsed": { "const": false },
        "issuerMatched": { "type": "boolean" },
        "authorizeEndpointObserved": { "type": "boolean" },
        "pkceS256Observed": { "type": "boolean" },
        "authorizationCodeCallbackObserved": { "type": "boolean" },
        "callbackOriginMatched": { "type": "boolean" },
        "codeExchangeObserved": { "type": "boolean" },
        "codeVerifierObserved": { "type": "boolean" },
        "stateCorrelationMatched": { "type": "boolean" },
        "codeCorrelationMatched": { "type": "boolean" },
        "pkceChallengeMatched": { "type": "boolean" },
        "tokenResponseSuccessful": { "type": "boolean" },
        "oauthParametersCleared": { "type": "boolean" },
        "loginBlockingViolationCount": { "type": "integer", "minimum": 0 }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedSourceSha",
        "observedSourceSha",
        "expectedFrontendDigest",
        "liveFrontendDigest",
        "expectedBuildRunId",
        "harnessRepository",
        "harnessRevision",
        "specSha256",
        "configSha256",
        "packageLockSha256",
        "chromiumExecutableSha256",
        "chromiumRevision",
        "chromiumBrowserVersion",
        "chromiumExecutableVersion",
        "playwrightVersion"
      ],
      "properties": {
        "expectedSourceSha": { "$ref": "#/definitions/gitSha" },
        "observedSourceSha": { "type": "string", "pattern": "^$|^[0-9a-f]{40}$" },
        "expectedFrontendDigest": { "$ref": "#/definitions/digest" },
        "liveFrontendDigest": { "$ref": "#/definitions/digest" },
        "expectedBuildRunId": { "const": "29451703189" },
        "harnessRepository": { "const": "Halildeu/platform-k8s-gitops" },
        "harnessRevision": { "$ref": "#/definitions/gitSha" },
        "specSha256": { "$ref": "#/definitions/sha256" },
        "configSha256": { "$ref": "#/definitions/sha256" },
        "packageLockSha256": { "$ref": "#/definitions/sha256" },
        "chromiumExecutableSha256": { "$ref": "#/definitions/sha256" },
        "chromiumRevision": { "const": "1223" },
        "chromiumBrowserVersion": { "const": "148.0.7778.96" },
        "chromiumExecutableVersion": {
          "$comment": "This protected lane launches the hashed full Chrome for Testing executable; Chromium Headless Shell is intentionally excluded.",
          "const": "Google Chrome for Testing 148.0.7778.96"
        },
        "playwrightVersion": { "const": "Version 1.60.0" }
      }
    },
    "authz": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userIdMatched",
        "subscriberIdMatched",
        "superAdminFalse",
        "exactRolesMatched",
        "exactModulesMatched",
        "exactAllowedModulesMatched",
        "exactPermissionsMatched",
        "manageGrantAbsent",
        "exactViewOnlySnapshotMatched"
      ],
      "properties": {
        "userIdMatched": { "type": "boolean" },
        "subscriberIdMatched": { "type": "boolean" },
        "superAdminFalse": { "type": "boolean" },
        "exactRolesMatched": { "type": "boolean" },
        "exactModulesMatched": { "type": "boolean" },
        "exactAllowedModulesMatched": { "type": "boolean" },
        "exactPermissionsMatched": { "type": "boolean" },
        "manageGrantAbsent": { "type": "boolean" },
        "exactViewOnlySnapshotMatched": { "type": "boolean" }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desktopHomePath",
        "desktopSidebarVisible",
        "desktopSidebarHref",
        "desktopSearchQuery",
        "desktopSearchResultVisible",
        "desktopHubPath",
        "desktopHubRendered",
        "desktopLaunchPath",
        "desktopRemoteConsoleRendered",
        "mobileViewportWidth",
        "mobileHomePath",
        "mobileMenuOpened",
        "mobileHrSectionOpened",
        "mobileAtsProductHubActionVisible",
        "mobileHubPath",
        "mobileHubRendered",
        "mobileLaunchPath",
        "mobileRemoteConsoleRendered"
      ],
      "properties": {
        "desktopHomePath": { "type": "string" },
        "desktopSidebarVisible": { "type": "boolean" },
        "desktopSidebarHref": { "type": "string" },
        "desktopSearchQuery": { "type": "string" },
        "desktopSearchResultVisible": { "type": "boolean" },
        "desktopHubPath": { "type": "string" },
        "desktopHubRendered": { "type": "boolean" },
        "desktopLaunchPath": { "type": "string" },
        "desktopRemoteConsoleRendered": { "type": "boolean" },
        "mobileViewportWidth": { "type": "integer", "minimum": 1 },
        "mobileHomePath": { "type": "string" },
        "mobileMenuOpened": { "type": "boolean" },
        "mobileHrSectionOpened": { "type": "boolean" },
        "mobileAtsProductHubActionVisible": { "type": "boolean" },
        "mobileHubPath": { "type": "string" },
        "mobileHubRendered": { "type": "boolean" },
        "mobileLaunchPath": { "type": "string" },
        "mobileRemoteConsoleRendered": { "type": "boolean" }
      }
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rendered",
        "runtimeReady",
        "capabilityIds",
        "targetRoleIds",
        "visibleCapabilityCount",
        "candidateFilterVisible",
        "candidateBoundaryVisible",
        "cvImportMode",
        "cvImportInteractiveControlCount",
        "fileUploadControlCount",
        "liveLaunchHref",
        "productBoundaryVisible"
      ],
      "properties": {
        "path": { "type": "string" },
        "rendered": { "type": "boolean" },
        "runtimeReady": { "type": "boolean" },
        "capabilityIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "uniqueItems": true
        },
        "targetRoleIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z_]+$" },
          "uniqueItems": true
        },
        "visibleCapabilityCount": { "type": "integer", "minimum": 0 },
        "candidateFilterVisible": { "type": "boolean" },
        "candidateBoundaryVisible": { "type": "boolean" },
        "cvImportMode": { "enum": ["OWNER_GATED"] },
        "cvImportInteractiveControlCount": { "type": "integer", "minimum": 0 },
        "fileUploadControlCount": { "type": "integer", "minimum": 0 },
        "liveLaunchHref": { "type": "string" },
        "productBoundaryVisible": { "type": "boolean" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finalPath",
        "profileIds",
        "gateIds",
        "headerLabels",
        "gateOwnerZeroCount",
        "ownerAcceptance",
        "readinessPercentagePresent",
        "verifierAction",
        "releaseAction",
        "interactiveControlIds"
      ],
      "properties": {
        "finalPath": { "type": "string" },
        "profileIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "gateIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "headerLabels": {
          "const": [
            "Kapı / authority",
            "Exact durum",
            "Kanıt sınıfı",
            "Drill",
            "Receipt / zaman",
            "Owner"
          ]
        },
        "gateOwnerZeroCount": { "type": "integer", "minimum": 0 },
        "ownerAcceptance": { "type": "string" },
        "readinessPercentagePresent": { "type": "boolean" },
        "verifierAction": { "type": "string" },
        "releaseAction": { "type": "string" },
        "interactiveControlIds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "responsive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewportWidth",
        "hubRootOverflowPx",
        "hubOverflowPx",
        "rootOverflowPx",
        "consoleOverflowPx",
        "evidenceTableKeyboardScrollable"
      ],
      "properties": {
        "viewportWidth": { "type": "integer", "minimum": 1 },
        "hubRootOverflowPx": { "type": "number", "minimum": 0 },
        "hubOverflowPx": { "type": "number", "minimum": 0 },
        "rootOverflowPx": { "type": "number", "minimum": 0 },
        "consoleOverflowPx": { "type": "number", "minimum": 0 },
        "evidenceTableKeyboardScrollable": { "type": "boolean" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loginBlockingViolationCount",
        "hubBlockingViolationCount",
        "productBlockingViolationCount",
        "blockingViolationCount",
        "violations"
      ],
      "properties": {
        "loginBlockingViolationCount": { "type": "integer", "minimum": 0 },
        "hubBlockingViolationCount": { "type": "integer", "minimum": 0 },
        "productBlockingViolationCount": { "type": "integer", "minimum": 0 },
        "blockingViolationCount": { "type": "integer", "minimum": 0 },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface", "id", "impact", "nodeCount"],
            "properties": {
              "surface": { "enum": ["login", "hub", "product"] },
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "impact": { "type": ["string", "null"] },
              "nodeCount": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncaughtPageErrorCount"],
      "properties": {
        "uncaughtPageErrorCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
