{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Halildeu/platform-k8s-gitops/schema/faz22-6-view-only-viewer-product-evidence-child-v2.schema.json",
  "title": "Faz 22.6 VIEW_ONLY source-specific child evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceType", "sourceRevision", "observedAt", "binding", "producer", "payload"],
  "properties": {
    "schemaVersion": {"const": "faz22.6.viewOnlyViewerProductChildEvidence.v2"},
    "evidenceType": {
      "enum": ["browser", "broker", "audit", "d30", "negative", "termination", "operator"]
    },
    "sourceRevision": {"$ref": "#/$defs/gitSha"},
    "observedAt": {"$ref": "#/$defs/utcTimestamp"},
    "binding": {"$ref": "#/$defs/binding"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tool", "toolVersion"],
      "properties": {
        "kind": {"enum": ["browser-harness", "prometheus-query", "audit-verifier", "d30-verifier", "negative-harness", "termination-harness", "protected-authorization"]},
        "tool": {"type": "string", "pattern": "^[A-Za-z0-9._/-]{3,160}$"},
        "toolVersion": {"type": "string", "pattern": "^[A-Za-z0-9._:+-]{1,80}$"}
      }
    },
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"evidenceType": {"const": "browser"}}},
      "then": {"properties": {"producer": {"properties": {"kind": {"const": "browser-harness"}, "toolVersion": {"const": "v3-ack-drain"}}}, "payload": {"$ref": "#/$defs/browserPayload"}}}
    },
    {
      "if": {"properties": {"evidenceType": {"const": "broker"}}},
      "then": {"properties": {"producer": {"properties": {"kind": {"const": "prometheus-query"}}}, "payload": {"$ref": "#/$defs/brokerPayload"}}}
    },
    {
      "if": {"properties": {"evidenceType": {"const": "audit"}}},
      "then": {"properties": {"producer": {"properties": {"kind": {"const": "audit-verifier"}}}, "payload": {"$ref": "#/$defs/auditPayload"}}}
    },
    {
      "if": {"properties": {"evidenceType": {"const": "d30"}}},
      "then": {"properties": {"producer": {"properties": {"kind": {"const": "d30-verifier"}}}, "payload": {"$ref": "#/$defs/d30Payload"}}}
    },
    {
      "if": {"properties": {"evidenceType": {"const": "negative"}}},
      "then": {"properties": {"producer": {"properties": {"kind": {"const": "negative-harness"}}}, "payload": {"$ref": "#/$defs/negativePayload"}}}
    },
    {
      "if": {"properties": {"evidenceType": {"const": "termination"}}},
      "then": {"properties": {"producer": {"properties": {"kind": {"const": "termination-harness"}}}, "payload": {"$ref": "#/$defs/terminationPayload"}}}
    },
    {
      "if": {"properties": {"evidenceType": {"const": "operator"}}},
      "then": {"properties": {"producer": {"properties": {"kind": {"const": "protected-authorization"}}}, "payload": {"$ref": "#/$defs/operatorPayload"}}}
    }
  ],
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "utcTimestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionSha256", "tenantSha256", "operatorSha256", "deviceSha256"],
      "properties": {
        "sessionSha256": {"$ref": "#/$defs/sha256"},
        "tenantSha256": {"$ref": "#/$defs/sha256"},
        "operatorSha256": {"$ref": "#/$defs/sha256"},
        "deviceSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured", "brokerReceived", "viewerDelivered", "viewerRendered"],
      "properties": {
        "captured": {"type": "integer", "minimum": 1},
        "brokerReceived": {"type": "integer", "minimum": 1},
        "viewerDelivered": {"type": "integer", "minimum": 1},
        "viewerRendered": {"type": "integer", "minimum": 1}
      }
    },
    "browserPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pilotStartedAt", "pilotEndedAt", "ackDrainCompleted", "ackDrainCutoffAt", "ackDrainNonceSha256", "ackDrainClosureKind", "imageElementRendered", "pixelCheckPassed", "inputChannelControlCount", "dlpMaskRectBps", "dlpMaskPixelCheckPassed", "activeIndicatorPixelCheckPassed", "maskedFrameSha256", "renderAckAttemptedCount", "renderAckAcceptedCount", "renderAckRejectedCount", "renderAckPendingCount", "consoleErrorCount", "screenshotSha256", "firstFrameAgeMillis", "steadyFrameAgeMillis", "consentEvidenceSha256", "meta"],
      "properties": {
        "pilotStartedAt": {"$ref": "#/$defs/utcTimestamp"},
        "pilotEndedAt": {"$ref": "#/$defs/utcTimestamp"},
        "ackDrainCompleted": {"const": true},
        "ackDrainCutoffAt": {"$ref": "#/$defs/utcTimestamp"},
        "ackDrainNonceSha256": {"$ref": "#/$defs/sha256"},
        "ackDrainClosureKind": {"enum": ["none", "stream-ended-after-drain"]},
        "imageElementRendered": {"const": true},
        "pixelCheckPassed": {"const": true},
        "inputChannelControlCount": {"const": 0},
        "dlpMaskRectBps": {"type": "string", "pattern": "^[0-9]{1,5},[0-9]{1,5},[0-9]{1,5},[0-9]{1,5}$"},
        "dlpMaskPixelCheckPassed": {"const": true},
        "activeIndicatorPixelCheckPassed": {"const": true},
        "maskedFrameSha256": {"$ref": "#/$defs/sha256"},
        "renderAckAttemptedCount": {"type": "integer", "minimum": 1},
        "renderAckAcceptedCount": {"type": "integer", "minimum": 1},
        "renderAckRejectedCount": {"const": 0},
        "renderAckPendingCount": {"const": 0},
        "consoleErrorCount": {"const": 0},
        "screenshotSha256": {"$ref": "#/$defs/sha256"},
        "firstFrameAgeMillis": {"type": "integer", "minimum": 1, "maximum": 60000},
        "steadyFrameAgeMillis": {"type": "array", "minItems": 100, "maxItems": 100000, "items": {"type": "integer", "minimum": 0, "maximum": 60000}},
        "consentEvidenceSha256": {"$ref": "#/$defs/sha256"},
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authentication", "recording", "attended", "capability", "viewerIdSha256"],
          "properties": {
            "authentication": {"const": "keycloak-authorization-code-pkce"},
            "recording": {"const": false},
            "attended": {"const": true},
            "capability": {"const": "VIEW_ONLY"},
            "viewerIdSha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "brokerPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "framesSentMetricDelta", "renderAckAcceptedMetricDelta", "renderAckRejectedMetricDelta", "reconnectCount", "backpressureMode", "maxPendingFrames", "metricsSnapshotSha256", "inputChannels", "dlp", "persistence"],
      "properties": {
        "states": {"$ref": "#/$defs/states"},
        "framesSentMetricDelta": {"type": "integer", "minimum": 1},
        "renderAckAcceptedMetricDelta": {"type": "integer", "minimum": 1},
        "renderAckRejectedMetricDelta": {"type": "integer", "minimum": 1},
        "reconnectCount": {"type": "integer", "minimum": 0},
        "backpressureMode": {"const": "latest-wins-single-slot"},
        "maxPendingFrames": {"const": 1},
        "metricsSnapshotSha256": {"$ref": "#/$defs/sha256"},
        "inputChannels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keyboard", "mouse", "clipboard", "fileTransfer", "credentialEntry", "shell", "portForward", "hiddenControl"],
          "properties": {
            "keyboard": {"const": false}, "mouse": {"const": false}, "clipboard": {"const": false}, "fileTransfer": {"const": false},
            "credentialEntry": {"const": false}, "shell": {"const": false}, "portForward": {"const": false}, "hiddenControl": {"const": false}
          }
        },
        "dlp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deliveredPathProven", "rawContentIncluded", "maskedFrameSha256"],
          "properties": {
            "deliveredPathProven": {"const": true},
            "rawContentIncluded": {"const": false},
            "maskedFrameSha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recordingMode", "contentPersisted", "contentStorageWrites"],
          "properties": {
            "recordingMode": {"const": "disabled"},
            "contentPersisted": {"const": false},
            "contentStorageWrites": {"const": 0}
          }
        }
      }
    },
    "auditPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewStartPresent", "viewStartCommittedBeforeFirstDelivered", "viewStopPresent", "hashChainVerified", "framesDelivered", "framesRenderAcknowledged", "snapshotSha256"],
      "properties": {
        "viewStartPresent": {"const": true},
        "viewStartCommittedBeforeFirstDelivered": {"const": true},
        "viewStopPresent": {"const": true},
        "hashChainVerified": {"const": true},
        "framesDelivered": {"type": "integer", "minimum": 1},
        "framesRenderAcknowledged": {"type": "integer", "minimum": 1},
        "snapshotSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "d30Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "snapshotSha256"],
      "properties": {
        "images": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["component", "desiredDigest", "liveImageIdDigest"],
            "properties": {
              "component": {"enum": ["backend", "web"]},
              "desiredDigest": {"$ref": "#/$defs/sha256"},
              "liveImageIdDigest": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "snapshotSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "negativePayload": {
      "type": "object", "additionalProperties": false,
      "required": ["suiteSha256", "authorizationSha256", "cases"],
      "properties": {
        "suiteSha256": {"$ref": "#/$defs/sha256"},
        "authorizationSha256": {"$ref": "#/$defs/sha256"},
        "cases": {
          "type": "object", "additionalProperties": false,
          "required": ["noAuth", "wrongRole", "wrongTenant", "wrongDevice", "expired", "revoked", "replayed", "overConcurrency", "disconnectedViewer"],
          "properties": {
            "noAuth": {"$ref": "#/$defs/negativeCase"},
            "wrongRole": {"$ref": "#/$defs/negativeCase"},
            "wrongTenant": {"$ref": "#/$defs/negativeCase"},
            "wrongDevice": {"$ref": "#/$defs/negativeCase"},
            "expired": {"$ref": "#/$defs/negativeCase"},
            "revoked": {"$ref": "#/$defs/negativeCase"},
            "replayed": {"$ref": "#/$defs/negativeCase"},
            "overConcurrency": {"$ref": "#/$defs/negativeCase"},
            "disconnectedViewer": {"$ref": "#/$defs/negativeCase"}
          }
        }
      }
    },
    "terminationPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["suiteSha256", "authorizationSha256", "cases"],
      "properties": {
        "suiteSha256": {"$ref": "#/$defs/sha256"},
        "authorizationSha256": {"$ref": "#/$defs/sha256"},
        "cases": {
          "type": "object", "additionalProperties": false,
          "required": ["localAbort", "killOrRevoke", "ttlExpiry", "heartbeatLoss", "indicatorLoss"],
          "properties": {
            "localAbort": {"$ref": "#/$defs/terminationCase"},
            "killOrRevoke": {"$ref": "#/$defs/terminationCase"},
            "ttlExpiry": {"$ref": "#/$defs/terminationCase"},
            "heartbeatLoss": {"$ref": "#/$defs/terminationCase"},
            "indicatorLoss": {"$ref": "#/$defs/terminationCase"}
          }
        }
      }
    },
    "negativeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "binding", "result", "outcome", "requestAccepted", "deliveryContinued", "httpStatus", "evidenceSha256"],
      "properties": {
        "observedAt": {"$ref": "#/$defs/utcTimestamp"},
        "binding": {"$ref": "#/$defs/binding"},
        "result": {"const": "fail-closed"},
        "outcome": {
          "enum": ["unauthorized", "not-found", "conflict", "expired", "revoked", "replay-rejected", "capacity-rejected", "stream-closed"]
        },
        "requestAccepted": {"const": false},
        "deliveryContinued": {"const": false},
        "httpStatus": {"oneOf": [{"type": "integer", "minimum": 100, "maximum": 599}, {"type": "null"}]},
        "evidenceSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "terminationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "binding", "result", "trigger", "deliveryTerminated", "terminationLatencyMillis", "evidenceSha256", "viewStopAuditSha256"],
      "properties": {
        "observedAt": {"$ref": "#/$defs/utcTimestamp"},
        "binding": {"$ref": "#/$defs/binding"},
        "result": {"const": "terminated"},
        "trigger": {"enum": ["local-abort", "kill-or-revoke", "ttl-expiry", "heartbeat-loss", "indicator-loss"]},
        "deliveryTerminated": {"const": true},
        "terminationLatencyMillis": {"type": "integer", "minimum": 0, "maximum": 120000},
        "evidenceSha256": {"$ref": "#/$defs/sha256"},
        "viewStopAuditSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "operatorPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["onePersonRoster", "pilotDeviceConsented", "exposureApproved", "protectedEnvironment", "activationRunId", "activationRunAttempt", "activationHeadSha", "authorizationArtifactId", "authorizationArtifactDigest", "authorizationSha256", "authorizationSchemaVersion", "ownerPolicySha256", "ownerDirectiveSha256", "aiAdvisorySha256", "legalTrackStatus", "legalClearanceClaimed"],
      "properties": {
        "onePersonRoster": {"const": true},
        "pilotDeviceConsented": {"const": true},
        "exposureApproved": {"const": true},
        "protectedEnvironment": {"const": "faz22-view-only-pilot"},
        "activationRunId": {"type": "integer", "minimum": 1},
        "activationRunAttempt": {"type": "integer", "minimum": 1},
        "activationHeadSha": {"$ref": "#/$defs/gitSha"},
        "authorizationArtifactId": {"type": "integer", "minimum": 1},
        "authorizationArtifactDigest": {"$ref": "#/$defs/sha256"},
        "authorizationSha256": {"$ref": "#/$defs/sha256"},
        "authorizationSchemaVersion": {"const": "faz22.6-view-only-pilot-protected-authorization-v3"},
        "ownerPolicySha256": {"$ref": "#/$defs/sha256"},
        "ownerDirectiveSha256": {"$ref": "#/$defs/sha256"},
        "aiAdvisorySha256": {"$ref": "#/$defs/sha256"},
        "legalTrackStatus": {"const": "tracked_pending"},
        "legalClearanceClaimed": {"const": false}
      }
    }
  }
}
