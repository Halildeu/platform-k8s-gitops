{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Halildeu/platform-k8s-gitops/blob/main/schema/cross-ai-deployment-policy-v2.schema.json",
  "title": "Cross-AI single-transaction deployment protection policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityContractVersion",
    "policyId",
    "phase",
    "machineOnlyEnabled",
    "repositoryId",
    "repository",
    "environment",
    "allowedApiOrigins",
    "allowedInstallationIds",
    "allowedDispatcherInstallationIds",
    "allowedDispatcherActorIds",
    "allowedDeploymentClasses",
    "maxGrantTtlMinutes",
    "maxRunAttempts",
    "requiredCustomRuleAppIds",
    "preflightArtifactPrefix",
    "workflowTransaction",
    "humanRequiredClasses"
  ],
  "properties": {
    "schemaVersion": {"const": "acik.cross-ai-deployment-policy.v2"},
    "authorityContractVersion": {"const": "v3"},
    "policyId": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
    "phase": {"enum": ["observe", "dual-gate"]},
    "machineOnlyEnabled": {"const": false},
    "repositoryId": {"type": "integer", "minimum": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "environment": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,120}$"},
    "allowedApiOrigins": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::[1-9][0-9]{0,4})?$"}
    },
    "allowedInstallationIds": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "allowedDispatcherInstallationIds": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "allowedDispatcherActorIds": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "allowedDeploymentClasses": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["reversible-test", "reversible-nonprod"]}
    },
    "maxGrantTtlMinutes": {"type": "integer", "minimum": 1, "maximum": 120},
    "maxRunAttempts": {"const": 1},
    "requiredCustomRuleAppIds": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "preflightArtifactPrefix": {"const": "faz22-view-only-transaction-preflight"},
    "workflowTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage", "workflowPath", "requiredPreflightRunsOnLabels",
        "requiredRunsOnLabels", "requireRunnerGroup",
        "requiresSameRunPreflight", "requiresOneProtectedEnvironmentGate",
        "requiredAuthorityPaths"
      ],
      "properties": {
        "stage": {"const": "transaction"},
        "workflowPath": {"const": ".github/workflows/faz22-6-view-only-viewer-transaction.yml"},
        "requiredPreflightRunsOnLabels": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        },
        "requiredRunsOnLabels": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        },
        "requireRunnerGroup": {"type": "boolean"},
        "requiresSameRunPreflight": {"const": true},
        "requiresOneProtectedEnvironmentGate": {"const": true},
        "requiredAuthorityPaths": {
          "type": "array", "minItems": 10, "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[.]github/workflows|config|docs|schema|scripts|tests)/[A-Za-z0-9_./-]+$"
          }
        }
      }
    },
    "humanRequiredClasses": {
      "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
      "items": {
        "enum": [
          "attended-consent", "legal-dpo", "named-authority",
          "production-secret-owner", "irreversible-production", "production", "break-glass"
        ]
      }
    }
  }
}
