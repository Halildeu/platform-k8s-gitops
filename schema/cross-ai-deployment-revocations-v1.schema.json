{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Halildeu/platform-k8s-gitops/blob/main/schema/cross-ai-deployment-revocations-v1.schema.json",
  "title": "Cross-AI deployment revocation set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revocationSetId", "issuedAt", "nextUpdate", "entries"],
  "properties": {
    "schemaVersion": {
      "const": "acik.cross-ai-deployment-revocations.v1"
    },
    "revocationSetId": {
      "type": "string",
      "format": "uuid"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "nextUpdate": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "effectiveAt", "reasonCode"],
      "properties": {
        "type": {
          "enum": ["key", "bundle", "review", "subject", "grant", "runner-lease", "issuer-runtime"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "effectiveAt": {
          "type": "string",
          "format": "date-time"
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        }
      }
    }
  }
}
