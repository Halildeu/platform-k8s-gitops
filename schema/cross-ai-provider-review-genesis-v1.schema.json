{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Halildeu/platform-k8s-gitops/blob/main/schema/cross-ai-provider-review-genesis-v1.schema.json",
  "title": "One-time direct Codex public-authority genesis contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "bootstrapReceiptPath",
    "expectedBootstrapReceiptSha256",
    "ownerDecision",
    "tracking",
    "protectedEnvironment",
    "transitionContract",
    "trustRootPath",
    "revocationsPath",
    "expectedTrustRootSha256",
    "issuerRuntimePolicy"
  ],
  "properties": {
    "schemaVersion": {"const": "acik.cross-ai-provider-review-genesis.v1"},
    "status": {"enum": ["installed", "staged", "retired"]},
    "bootstrapReceiptPath": {"const": "config/github-apps/cross-ai-transit-bootstrap-receipt.v2.json"},
    "expectedBootstrapReceiptSha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      ]
    },
    "ownerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiRef", "bodySha256", "owner", "authorAssociation", "createdAt", "updatedAt"],
      "properties": {
        "apiRef": {"const": "https://api.github.com/repos/Halildeu/platform-k8s-gitops/issues/comments/5014836397"},
        "bodySha256": {"const": "sha256:4b6a269ed29c717bb826c59cb6be4b60e93a781bf989850a2361768723925f79"},
        "owner": {"const": "Halildeu"},
        "authorAssociation": {"const": "OWNER"},
        "createdAt": {"const": "2026-07-19T07:17:54Z"},
        "updatedAt": {"const": "2026-07-19T07:17:54Z"}
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enablerIssue", "customerJourneyIssue", "customerJourney"],
      "properties": {
        "enablerIssue": {"const": "Halildeu/platform-k8s-gitops#2688"},
        "customerJourneyIssue": {"const": "Halildeu/platform-k8s-gitops#2373"},
        "customerJourney": {"const": "protected-test-activation-to-attended-view-only-render-to-durable-product-evidence"}
      }
    },
    "protectedEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "workflowPath", "trustedRef", "maxRunAgeHours", "requireHumanReviewer", "preventSelfReview"],
      "properties": {
        "name": {"const": "cross-ai-provider-review-genesis"},
        "workflowPath": {"const": ".github/workflows/cross-ai-provider-review-genesis.yml"},
        "trustedRef": {"const": "refs/heads/main"},
        "maxRunAgeHours": {"const": 24},
        "requireHumanReviewer": {"const": true},
        "preventSelfReview": {"const": true}
      }
    },
    "transitionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stagePublicAuthority", "activateAuthority"],
      "properties": {
        "stagePublicAuthority": {"$ref": "#/$defs/stageTransition"},
        "activateAuthority": {"$ref": "#/$defs/activateTransition"}
      }
    },
    "trustRootPath": {
      "oneOf": [
        {"type": "null"},
        {"const": "config/github-apps/cross-ai-provider-review-trust-root.v2.json"}
      ]
    },
    "revocationsPath": {
      "oneOf": [
        {"type": "null"},
        {"const": "config/github-apps/cross-ai-provider-review-revocations.v1.dsse.json"}
      ]
    },
    "expectedTrustRootSha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      ]
    },
    "issuerRuntimePolicy": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "workloadIdentity", "issuerImageDigest", "launcherSourceSha256", "attestorKeyId", "maxAttestationLifetimeSeconds", "apiOrigin", "sessionPath", "authAudience", "kubernetesNamespace", "kubernetesServiceAccount", "kubernetesContainerName", "kubernetesApiAudience", "kubernetesContainerCommand", "kubernetesContainerArgsSha256", "kubernetesContainerSecurityContextSha256", "vaultKubernetesAuthMount", "vaultKubernetesRole", "vaultTokenPolicy", "maxReplicas"],
          "properties": {
            "schemaVersion": {"const": "acik.cross-ai-provider-review-runtime-policy.v1"},
            "workloadIdentity": {"const": "spiffe://testai.acik.com/ns/cross-ai/sa/provider-review-issuer"},
            "issuerImageDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "launcherSourceSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "attestorKeyId": {"type": "string", "pattern": "^vault-transit://cross-ai/runner-management#v[1-9][0-9]*$"},
            "maxAttestationLifetimeSeconds": {"const": 600},
            "apiOrigin": {"type": "string", "pattern": "^https://[a-z0-9.-]+(?::[1-9][0-9]{0,4})?$"},
            "sessionPath": {"const": "/api/v1/cross-ai/provider-review-runtime/sessions"},
            "authAudience": {"const": "acik-cross-ai-provider-review-runtime"},
            "kubernetesNamespace": {"const": "cross-ai"},
            "kubernetesServiceAccount": {"const": "provider-review-issuer"},
            "kubernetesContainerName": {"const": "runtime-attestor"},
            "kubernetesApiAudience": {"const": "https://kubernetes.default.svc.cluster.local"},
            "kubernetesContainerCommand": {"const": ["python", "-m", "scripts.ai.run_cross_ai_runtime_attestor"]},
            "kubernetesContainerArgsSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "kubernetesContainerSecurityContextSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "vaultKubernetesAuthMount": {"const": "kubernetes"},
            "vaultKubernetesRole": {"const": "cross-ai-provider-review-runtime"},
            "vaultTokenPolicy": {"const": "cross-ai-runner-management-test"},
            "maxReplicas": {"const": 1}
          }
        }
      ]
    }
  },
  "$defs": {
    "stageTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromStatus", "toStatus", "consultationMode", "authority", "exactChangedPaths"],
      "properties": {
        "fromStatus": {"const": "installed"},
        "toStatus": {"const": "staged"},
        "consultationMode": {"const": "none"},
        "authority": {"const": "protected-environment-human-genesis"},
        "exactChangedPaths": {
          "const": [
            "config/github-apps/cross-ai-provider-review-genesis.v1.json",
            "config/github-apps/cross-ai-provider-review-revocations.v1.dsse.json",
            "config/github-apps/cross-ai-provider-review-trust-root.v2.json",
            "config/github-apps/cross-ai-transit-bootstrap-receipt.v2.json"
          ]
        }
      }
    },
    "activateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromStatus", "toStatus", "consultationMode", "consultationClass", "model", "authority", "exactChangedPaths"],
      "properties": {
        "fromStatus": {"const": "staged"},
        "toStatus": {"const": "retired"},
        "consultationMode": {"const": "single"},
        "consultationClass": {"const": "high-impact"},
        "model": {"const": "gpt-5.6-sol"},
        "authority": {"const": "staged-public-authority-plus-protected-environment"},
        "exactChangedPaths": {
          "const": [
            "config/github-apps/cross-ai-provider-review-authority.v1.json",
            "config/github-apps/cross-ai-provider-review-genesis.v1.json"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "installed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "trustRootPath": {"type": "null"},
          "revocationsPath": {"type": "null"},
          "expectedBootstrapReceiptSha256": {"type": "null"},
          "expectedTrustRootSha256": {"type": "null"},
          "issuerRuntimePolicy": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "trustRootPath": {"type": "string"},
          "revocationsPath": {"type": "string"},
          "expectedBootstrapReceiptSha256": {"type": "string"},
          "expectedTrustRootSha256": {"type": "string"},
          "issuerRuntimePolicy": {"type": "object"}
        }
      }
    }
  ]
}
