{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Halildeu/platform-k8s-gitops/blob/main/schema/cross-ai-runner-admission-lease-v1.schema.json",
  "title": "Cross-AI runner admission lease v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "leaseId",
    "requestId",
    "repositoryId",
    "repository",
    "environment",
    "headSha",
    "intentRef",
    "runnerPolicySha256",
    "inventoryGenerationSha256",
    "issuedAt",
    "expiresAt",
    "eligibleRunners"
  ],
  "properties": {
    "schemaVersion": {
      "const": "acik.cross-ai-runner-admission-lease.v1"
    },
    "leaseId": {
      "type": "string",
      "format": "uuid"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "repositoryId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "environment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,120}$"
    },
    "headSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "intentRef": {
      "type": "string",
      "pattern": "^refs/tags/cross-ai-intent/[0-9a-f-]{36}$"
    },
    "runnerPolicySha256": {
      "$ref": "#/$defs/digest"
    },
    "inventoryGenerationSha256": {
      "$ref": "#/$defs/digest"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "eligibleRunners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/runner"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runnerId",
        "runnerNameSha256",
        "labels",
        "attestationClass"
      ],
      "properties": {
        "runnerId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "runnerNameSha256": {
          "$ref": "#/$defs/digest"
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "attestationClass": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
        }
      }
    }
  }
}
