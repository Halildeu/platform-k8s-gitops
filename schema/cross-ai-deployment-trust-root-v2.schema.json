{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Halildeu/platform-k8s-gitops/blob/main/schema/cross-ai-deployment-trust-root-v2.schema.json",
  "title": "Cross-AI deployment trust root v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trustRootId",
    "sourcePublicKeysetSha256",
    "issuedAt",
    "expiresAt",
    "maxClockSkewSeconds",
    "requiredProviderFamilies",
    "minimumProviderFamilies",
    "minimumDirectProviderRoutes",
    "providerReviewRuntimePolicy",
    "keys"
  ],
  "properties": {
    "schemaVersion": {
      "const": "acik.cross-ai-deployment-trust-root.v2"
    },
    "trustRootId": {
      "type": "string",
      "format": "uuid"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "maxClockSkewSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "requiredProviderFamilies": {
      "const": [
        "openai"
      ]
    },
    "minimumProviderFamilies": {
      "const": 1
    },
    "minimumDirectProviderRoutes": {
      "const": 1
    },
    "providerReviewRuntimePolicy": {
      "$ref": "#/$defs/provider_review_runtime_policy"
    },
    "keys": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/key"
      }
    },
    "sourcePublicKeysetSha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "provider_review_runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "workloadIdentity",
        "issuerImageDigest",
        "launcherSourceSha256",
        "attestorKeyId",
        "maxAttestationLifetimeSeconds",
        "apiOrigin",
        "sessionPath",
        "authAudience",
        "kubernetesNamespace",
        "kubernetesServiceAccount",
        "kubernetesContainerName",
        "kubernetesApiAudience",
        "kubernetesContainerCommand",
        "kubernetesContainerArgsSha256",
        "kubernetesContainerSecurityContextSha256",
        "vaultKubernetesAuthMount",
        "vaultKubernetesRole",
        "vaultTokenPolicy",
        "maxReplicas"
      ],
      "properties": {
        "schemaVersion": {
          "const": "acik.cross-ai-provider-review-runtime-policy.v1"
        },
        "workloadIdentity": {
          "const": "spiffe://testai.acik.com/ns/cross-ai/sa/provider-review-issuer"
        },
        "issuerImageDigest": {
          "$ref": "#/$defs/digest"
        },
        "launcherSourceSha256": {
          "$ref": "#/$defs/digest"
        },
        "attestorKeyId": {
          "type": "string",
          "pattern": "^vault-transit://cross-ai/runner-management#v[1-9][0-9]*$"
        },
        "maxAttestationLifetimeSeconds": {
          "const": 600
        },
        "apiOrigin": {
          "type": "string",
          "pattern": "^https://[a-z0-9.-]+(?::[1-9][0-9]{0,4})?$"
        },
        "sessionPath": {
          "const": "/api/v1/cross-ai/provider-review-runtime/sessions"
        },
        "authAudience": {
          "const": "acik-cross-ai-provider-review-runtime"
        },
        "kubernetesNamespace": {"const": "cross-ai"},
        "kubernetesServiceAccount": {"const": "provider-review-issuer"},
        "kubernetesContainerName": {"const": "runtime-attestor"},
        "kubernetesApiAudience": {"const": "https://kubernetes.default.svc.cluster.local"},
        "kubernetesContainerCommand": {"const": ["python", "-m", "scripts.ai.run_cross_ai_runtime_attestor"]},
        "kubernetesContainerArgsSha256": {"$ref": "#/$defs/digest"},
        "kubernetesContainerSecurityContextSha256": {"$ref": "#/$defs/digest"},
        "vaultKubernetesAuthMount": {"const": "kubernetes"},
        "vaultKubernetesRole": {"const": "cross-ai-provider-review-runtime"},
        "vaultTokenPolicy": {"const": "cross-ai-runner-management-test"},
        "maxReplicas": {"const": 1}
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "role",
        "publicKeyBase64",
        "notBefore",
        "notAfter",
        "providerFamily",
        "allowedChannels",
        "allowedModelIds",
        "allowedModelIdentityClasses",
        "directProviderCli"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "pattern": "^vault-transit://[a-z0-9/_-]+#v[1-9][0-9]*$"
        },
        "role": {
          "enum": [
            "provider-review",
            "coordinator",
            "revocation",
            "runner-management"
          ]
        },
        "publicKeyBase64": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44
        },
        "notBefore": {
          "type": "string",
          "format": "date-time"
        },
        "notAfter": {
          "type": "string",
          "format": "date-time"
        },
        "providerFamily": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,31}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowedChannels": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          }
        },
        "allowedModelIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,159}$"
          }
        },
        "allowedModelIdentityClasses": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1,
          "items": {
            "enum": [
              "provider-reported",
              "trusted-launch-attested"
            ]
          }
        },
        "directProviderCli": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "provider-review"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "providerFamily": {
                "enum": [
                  "openai"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "provider-review"
              },
              "providerFamily": {
                "const": "openai"
              }
            },
            "required": [
              "role",
              "providerFamily"
            ]
          },
          "then": {
            "properties": {
              "allowedChannels": {
                "const": [
                  "openai-codex"
                ]
              },
              "allowedModelIds": {
                "const": [
                  "gpt-5.3-codex-spark",
                  "gpt-5.6-sol"
                ]
              },
              "allowedModelIdentityClasses": {
                "const": [
                  "trusted-launch-attested"
                ]
              },
              "directProviderCli": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "coordinator",
                  "revocation",
                  "runner-management"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "providerFamily": {
                "type": "null"
              },
              "allowedChannels": {
                "maxItems": 0
              },
              "allowedModelIds": {
                "maxItems": 0
              },
              "allowedModelIdentityClasses": {
                "maxItems": 0
              },
              "directProviderCli": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
