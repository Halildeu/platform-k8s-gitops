{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Halildeu/platform-k8s-gitops/blob/main/schema/cross-ai-provider-review-authority-v1.schema.json",
  "title": "Direct Codex provider-review public authority locator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "authoritySource",
    "codexExecutablePolicy",
    "trustRootPath",
    "revocationsPath",
    "expectedTrustRootSha256",
    "issuerRuntimePolicy",
    "rotationPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "acik.cross-ai-provider-review-authority.v1"
    },
    "status": {
      "enum": ["tracked_pending", "active"]
    },
    "authoritySource": {
      "const": "test-vault-transit-public-export"
    },
    "codexExecutablePolicy": {
      "$ref": "#/$defs/codexExecutablePolicy"
    },
    "trustRootPath": {
      "oneOf": [
        {"type": "null"},
        {"const": "config/github-apps/cross-ai-provider-review-trust-root.v2.json"}
      ]
    },
    "revocationsPath": {
      "oneOf": [
        {"type": "null"},
        {"const": "config/github-apps/cross-ai-provider-review-revocations.v1.dsse.json"}
      ]
    },
    "expectedTrustRootSha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      ]
    },
    "issuerRuntimePolicy": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/issuerRuntimePolicy"}
      ]
    },
    "rotationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTrustRootLifetimeHours",
        "maxProviderKeyRotationHours",
        "minimumKeyOverlapHours",
        "maxRevocationStalenessMinutes",
        "maxReviewLeafLifetimeMinutes"
      ],
      "properties": {
        "maxTrustRootLifetimeHours": {"const": 720},
        "maxProviderKeyRotationHours": {"const": 168},
        "minimumKeyOverlapHours": {"const": 24},
        "maxRevocationStalenessMinutes": {"const": 60},
        "maxReviewLeafLifetimeMinutes": {"const": 120}
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "codexExecutablePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "allowedExecutables"],
      "properties": {
        "schemaVersion": {
          "const": "acik.codex-executable-policy.v1"
        },
        "allowedExecutables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "sourceClass",
              "packageName",
              "packageVersion",
              "cliSha256",
              "cliVersion",
              "cliVersionSha256",
              "signatureType",
              "signatureIdentity",
              "signatureTeamId",
              "signatureCdHashSha256"
            ],
            "properties": {
              "platform": {"enum": ["darwin-arm64", "darwin-x64"]},
              "sourceClass": {
                "const": "official-openai-npm-bundled-native"
              },
              "packageName": {"const": "@openai/codex"},
              "packageVersion": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "cliSha256": {"$ref": "#/$defs/digest"},
              "cliVersion": {
                "type": "string",
                "pattern": "^codex-cli [0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "cliVersionSha256": {"$ref": "#/$defs/digest"},
              "signatureType": {"const": "apple-developer-id"},
              "signatureIdentity": {
                "const": "Developer ID Application: OpenAI OpCo, LLC (2DC432GLL2)"
              },
              "signatureTeamId": {"const": "2DC432GLL2"},
              "signatureCdHashSha256": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    },
    "issuerRuntimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "workloadIdentity",
        "issuerImageDigest",
        "launcherSourceSha256",
        "attestorKeyId",
        "maxAttestationLifetimeSeconds"
      ],
      "properties": {
        "schemaVersion": {"const": "acik.cross-ai-provider-review-runtime-policy.v1"},
        "workloadIdentity": {"const": "spiffe://testai.acik.com/ns/cross-ai/sa/provider-review-issuer"},
        "issuerImageDigest": {"$ref": "#/$defs/digest"},
        "launcherSourceSha256": {"$ref": "#/$defs/digest"},
        "attestorKeyId": {"type": "string", "pattern": "^vault-transit://cross-ai/runner-management#v[1-9][0-9]*$"},
        "maxAttestationLifetimeSeconds": {"const": 600}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "active"}}, "required": ["status"]},
      "then": {
        "properties": {
          "trustRootPath": {"type": "string"},
          "revocationsPath": {"type": "string"},
          "expectedTrustRootSha256": {"type": "string"},
          "issuerRuntimePolicy": {"type": "object"}
        }
      },
      "else": {
        "properties": {
          "trustRootPath": {"type": "null"},
          "revocationsPath": {"type": "null"},
          "expectedTrustRootSha256": {"type": "null"},
          "issuerRuntimePolicy": {"type": "null"}
        }
      }
    }
  ]
}
