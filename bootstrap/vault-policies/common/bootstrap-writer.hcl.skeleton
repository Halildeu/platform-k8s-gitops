# bootstrap/vault-policies/common/bootstrap-writer.hcl — SKELETON
#
# This is a SKELETON. The full policy lands in DR-2 (next PR after ADR-0010).
# This file documents the authority boundary and capabilities matrix that
# DR-2 must implement; it is NOT applied to any Vault instance yet.
#
# Codex consensus: thread `019dd2c9` (xhigh effort architecture review).
# ADR: docs/adr/0010-vault-credential-lifecycle-and-dr.md §2.1.
#
# Naming: `platform-bootstrap-writer` AppRole (matches policy name).
# Lifecycle: short-lived secret-id (TTL 30-60 min), low num_uses, never in Git.
# Test/Prod separation: separate roles per environment, separate secret-ids.

# ============================================================================
# CONTRACT (DR-2 will translate to actual HCL)
# ============================================================================
#
# ALLOW:
# - kv/data/platform/<service>: create, update, read
#   Where <service> ∈ {auth-service, user-service, variant-service,
#                      core-data-service, report-service, schema-service,
#                      permission-service, openfga}
# - sys/capabilities-self: read (so the wrapper can fail-fast pre-write)
# - auth/token/lookup-self: read (audit metadata visibility)
#
# DENY (explicit):
# - kv/metadata/* delete (preserves audit trail)
# - kv/data/<any> delete (no destructive operation; this is for write only)
# - sys/* (no Vault admin)
# - auth/* (no auth backend admin or token admin)
# - sys/policies/* (no policy escalation)
# - sys/seal/* + sys/unseal (no DR ops via this role)
# - sys/generate-root/* (root-regen is admin-only, separate path)
# - identity/* (no entity manipulation)
# - sys/audit/* (audit configuration is admin-only)
# - sys/wrapping/* (no token wrapping admin)
#
# ============================================================================
# EXAMPLE STRUCTURE (illustrative — DR-2 ships the working file)
# ============================================================================
#
# # Service-specific kv/data write paths
# path "kv/data/platform/auth-service"        { capabilities = ["create", "update", "read"] }
# path "kv/data/platform/user-service"        { capabilities = ["create", "update", "read"] }
# path "kv/data/platform/variant-service"     { capabilities = ["create", "update", "read"] }
# path "kv/data/platform/core-data-service"   { capabilities = ["create", "update", "read"] }
# path "kv/data/platform/report-service"      { capabilities = ["create", "update", "read"] }
# path "kv/data/platform/schema-service"      { capabilities = ["create", "update", "read"] }
# path "kv/data/platform/permission-service"  { capabilities = ["create", "update", "read"] }
# path "kv/data/platform/openfga"             { capabilities = ["create", "update", "read"] }
#
# # Operational
# path "sys/capabilities-self"  { capabilities = ["read"] }
# path "auth/token/lookup-self" { capabilities = ["read"] }
#
# # Explicit denials (defense-in-depth even though absence of grant = no access)
# path "kv/metadata/+/+" { capabilities = ["deny"] }
# path "kv/delete/+/+"   { capabilities = ["deny"] }
# path "sys/*"           { capabilities = ["deny"] }
# path "auth/*"          { capabilities = ["deny"] }
# path "identity/*"      { capabilities = ["deny"] }
#
# ============================================================================
# Application of this policy (DR-2 will document; sketch here):
#
#   vault policy write platform-bootstrap-writer \
#     bootstrap/vault-policies/common/bootstrap-writer.hcl
#
#   vault write auth/approle/role/platform-bootstrap-writer \
#     token_policies="platform-bootstrap-writer" \
#     token_ttl=30m token_max_ttl=60m \
#     secret_id_ttl=60m secret_id_num_uses=10 \
#     bind_secret_id=true
#
#   ROLE_ID=$(vault read -field=role_id auth/approle/role/platform-bootstrap-writer/role-id)
#   SECRET_ID=$(vault write -force -field=secret_id auth/approle/role/platform-bootstrap-writer/secret-id)
#
#   # Operator transfers ROLE_ID + SECRET_ID to the bootstrap caller via
#   # secure channel. Wrapper script (DR-3) consumes these.
#
# ============================================================================
# Capability self-test (DR-2 ships this as a smoke gate):
#
#   curl -sf -X POST -H "X-Vault-Token: $TOKEN" \
#     http://127.0.0.1:8301/v1/sys/capabilities-self \
#     -d '{"paths":["kv/data/platform/permission-service"]}' \
#     | jq -e '.capabilities | (contains(["create"]) and contains(["update"]) and (any(. == "delete") | not))'
#
#   Expected: exit 0 (create + update present, delete absent).
#
# ============================================================================
# Negative tests (DR-2):
#
#   # Must FAIL with 403 — confirms boundary
#   curl -sf -X DELETE -H "X-Vault-Token: $TOKEN" \
#     http://127.0.0.1:8301/v1/sys/policy/platform-bootstrap-writer
#
#   curl -sf -X POST -H "X-Vault-Token: $TOKEN" \
#     http://127.0.0.1:8301/v1/sys/auth/approle
#
#   curl -sf -X POST -H "X-Vault-Token: $TOKEN" \
#     http://127.0.0.1:8301/v1/sys/generate-root/attempt
#
#   curl -sf -X DELETE -H "X-Vault-Token: $TOKEN" \
#     http://127.0.0.1:8301/v1/kv/metadata/platform/permission-service
