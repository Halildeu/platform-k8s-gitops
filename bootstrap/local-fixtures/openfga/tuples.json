{
  "_comment": "Faz 17.1 OpenFGA tuple fixtures — NOT_FOR_PROD. Mac k3d-dev seed.",
  "_notes": [
    "Mac k3d-dev cluster'ında openfga StatefulSet ayağa kalktıktan sonra",
    "dev-seed.sh scripti bu tuple'ları `openfga` API'sine yükler.",
    "Schema: user can view/edit project (ADMIN → owner, USER → viewer).",
    "zanzibar-min smoke: dev-local user view/edit kontrolü /variants endpoint üzerinden."
  ],
  "model": "bootstrap/local-fixtures/openfga/model.fga",
  "tuples": [
    {"user": "user:dev@localtest.me", "relation": "owner", "object": "project:dev-local"},
    {"user": "user:dev@localtest.me", "relation": "admin", "object": "company:dev"},
    {"user": "user:viewer@localtest.me", "relation": "viewer", "object": "project:dev-local"},
    {"user": "user:viewer@localtest.me", "relation": "member", "object": "company:dev"},
    {"user": "user:dev@localtest.me", "relation": "editor", "object": "variant:sample-variant-1"},
    {"user": "user:viewer@localtest.me", "relation": "viewer", "object": "variant:sample-variant-1"}
  ],
  "smoke_checks": [
    {"description": "dev@localtest.me can view project:dev-local", "expected": true,
     "check": {"user": "user:dev@localtest.me", "relation": "can_view", "object": "project:dev-local"}},
    {"description": "viewer@localtest.me cannot edit variant", "expected": false,
     "check": {"user": "user:viewer@localtest.me", "relation": "can_edit", "object": "variant:sample-variant-1"}}
  ],
  "_future_multi_org_tuples": {
    "_status": "DEFERRED — NOT loaded by dev-seed.sh until backend OpenFGA model adds organization + depot types per ADR-0008. Loading these now would 400 (unknown type).",
    "_authority": "docs/adr/0008-multi-org-explicit-scope-zanzibar.md",
    "_loading_gate": "After backend repo PR merges openfga-authorization-model.fga with organization + depot, move these into the active 'tuples' array via a follow-up PR.",
    "tuples_after_backend_model_update": [
      {"user": "user:admin@localtest.me",          "relation": "admin",  "object": "organization:acik"},
      {"user": "user:member@localtest.me",         "relation": "member", "object": "organization:acik"},
      {"user": "user:company-viewer@localtest.me", "relation": "viewer", "object": "company:wc-company-1001"},
      {"user": "user:project-viewer@localtest.me", "relation": "viewer", "object": "project:wc-project-1204"},
      {"user": "user:branch-viewer@localtest.me",  "relation": "viewer", "object": "branch:wc-branch-7"},
      {"user": "user:depot-viewer@localtest.me",   "relation": "viewer", "object": "warehouse:wc-department-3792"}
    ],
    "smoke_checks_after_backend_model_update": [
      {"description": "admin can administer AÇIK", "expected": true,
       "check": {"user": "user:admin@localtest.me", "relation": "admin", "object": "organization:acik"}},
      {"description": "member can NOT view company (explicit-scope contract)", "expected": false,
       "check": {"user": "user:member@localtest.me", "relation": "viewer", "object": "company:wc-company-1001"}},
      {"description": "explicit company viewer can view that company", "expected": true,
       "check": {"user": "user:company-viewer@localtest.me", "relation": "viewer", "object": "company:wc-company-1001"}},
      {"description": "explicit depot viewer can view that depot", "expected": true,
       "check": {"user": "user:depot-viewer@localtest.me", "relation": "viewer", "object": "warehouse:wc-department-3792"}},
      {"description": "depot viewer can NOT view sub-depot (no transitive parent_depot)", "expected": false,
       "check": {"user": "user:depot-viewer@localtest.me", "relation": "viewer", "object": "warehouse:wc-department-3792-01"}},
      {"description": "company viewer can NOT view depot (cross-kind isolation)", "expected": false,
       "check": {"user": "user:company-viewer@localtest.me", "relation": "viewer", "object": "warehouse:wc-department-3792"}}
    ]
  }
}
