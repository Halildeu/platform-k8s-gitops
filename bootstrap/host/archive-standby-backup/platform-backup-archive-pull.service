[Unit]
Description=Pull aiserver backups into the .53 archive standby
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/aiserver-archive/ARCHIVE_STANDBY

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/platform-backup-archive-pull
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/platform/archive /run/lock
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
