# GPP-2 AO Gate Runtime — operator .env template
#
# Copy this file to `.env` next to compose.yaml and fill operator-specific
# values. NEVER commit `.env`. The brief contract (Codex 019dd24f post-merge
# follow-up + 019dfa18 review absorb) is "only secret IDs here, never values"
# — values live in Vault, this file only points at them.
#
# Quick start:
#   cp .env.example .env
#   # fill the three REQUIRED operator values below
#   # (compose fails-fast on empty: VAULT_TOKEN, AO_GITHUB_APP_ID,
#   #  AO_RELEASE_GATE_GPP_STATUS_HOST_PATH)
#   docker compose --env-file .env up -d
#   curl -fsS http://127.0.0.1:18081/healthz | jq -e '.program_id == "GPP-2q"'
#   curl -fsS http://127.0.0.1:18082/healthz | jq -e '.program_id == "GPP-2w"'

# ============================================================================
# REQUIRED — compose will not start if any of these is empty (fail-fast)
# ============================================================================

# Vault auth token used by ao-kernel hashicorp_vault provider to read the
# webhook secrets and the GitHub App private key. Operator generates this on
# the Vault prod side (e.g. AppRole login or root token for bootstrap).
# Never commit a real token; .env is .gitignore'd.
VAULT_TOKEN=

# GitHub App identity (Codex `019e4a10` Decision 2 AGREE_A: two
# Apps, one App per service). Per-service env is the recommended
# path; the shared `AO_GITHUB_APP_ID` below is kept as a
# backward-compat fallback for operators still on the single-App
# layout. compose.yaml falls back to the shared env when a
# per-service env is unset.
#
# Recommended for new operators:
AO_POLICY_GITHUB_APP_ID=
AO_RELEASE_GATE_GITHUB_APP_ID=

# Legacy single-App fallback (numeric ID public-safe — visible on
# the App settings page; private key fetched from Vault path below).
# Leave empty if you set the per-service env above.
AO_GITHUB_APP_ID=

# Read-only host path to the gpp_status.v1.json file the ao-release-gate
# runtime loads at /github/ao-release-gate request time. Suggested location:
#   /srv/platform/stateful/prod/ao-release-gate/gpp_status.v1.json
# (operator owns content; container mounts it read-only at /app/gpp_status.v1.json)
AO_RELEASE_GATE_GPP_STATUS_HOST_PATH=

# ============================================================================
# Image tags (defaults follow latest ao-kernel main push)
# ============================================================================
# Default `:main` follows the latest ao-kernel main push (deploy artefact, NOT
# GPP evidence). For evidence pin to a per-build sha tag — both ao-kernel
# container-publish workflows push `:sha-<SHA>` alongside `:main`:
#   AO_POLICY_IMAGE_TAG=sha-abc1234567890abcdef...
#   AO_RELEASE_GATE_IMAGE_TAG=sha-abc1234567890abcdef...
AO_POLICY_IMAGE_TAG=main
AO_RELEASE_GATE_IMAGE_TAG=main

# ============================================================================
# Secrets provider (Vault) — defaults match host-compose/vault/prod
# ============================================================================
SECRETS_PROVIDER=hashicorp_vault

# Vault prod intra-network DNS — matches host-compose/vault/prod hostname.
# Override only if your operator network differs.
VAULT_ADDR=http://platform-vault-prod:8200
VAULT_SECRET_MOUNT=secret

# ============================================================================
# Vault secret IDs (KV v2 paths) — values stored in Vault, NOT here
# ============================================================================
# Per-service private key secret-ids (recommended). Each App has its
# own private-key PEM in vault under its own secret id.
AO_POLICY_GITHUB_APP_PRIVATE_KEY_PEM_ID=gpp2/github/policy-private-key-pem
AO_RELEASE_GATE_GITHUB_APP_PRIVATE_KEY_PEM_ID=gpp2/github/release-gate-private-key-pem

# Legacy single-App private-key fallback (compose.yaml falls back
# to this when the per-service env above is unset):
AO_GITHUB_APP_PRIVATE_KEY_PEM_ID=gpp2/github/private-key-pem

AO_LIVE_ADAPTER_GATE_WEBHOOK_SECRET_ID=gpp2/policy/webhook-secret
AO_RELEASE_GATE_WEBHOOK_SECRET_ID=gpp2/release-gate/webhook-secret

# ============================================================================
# Optional tunables (defaults shown — uncomment to override)
# ============================================================================
# AO_GITHUB_API_URL=https://api.github.com
# WEB_CONCURRENCY=1
# WEB_THREADS=4
# WEB_TIMEOUT=30
# AO_POLICY_SERVICE_MAX_BODY_BYTES=1048576
# AO_RELEASE_GATE_MAX_BODY_BYTES=1048576
