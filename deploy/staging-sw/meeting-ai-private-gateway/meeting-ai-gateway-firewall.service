[Unit]
Description=Faz 24 Meeting-AI WireGuard ingress firewall
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Before=meeting-ai-private-gateway.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/platform/meeting-ai-gateway-firewall apply
ExecStartPost=/usr/local/libexec/platform/meeting-ai-gateway-firewall check
ExecStop=/usr/local/libexec/platform/meeting-ai-gateway-firewall rollback

[Install]
WantedBy=multi-user.target
