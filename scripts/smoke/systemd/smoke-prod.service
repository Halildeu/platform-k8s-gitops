[Unit]
Description=D29 Smoke Runner — prod cluster (after-deploy evidence pipeline)
Documentation=https://github.com/Halildeu/platform-k8s-gitops/blob/main/scripts/smoke/d29-smoke-runner.sh
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=halil
WorkingDirectory=/home/halil/platform/platform-k8s-gitops
Environment=PLATFORM_GITOPS_REPO=/home/halil/platform/platform-k8s-gitops
ExecStartPre=/usr/bin/git -C /home/halil/platform/platform-k8s-gitops fetch origin main --quiet
ExecStartPre=/usr/bin/git -C /home/halil/platform/platform-k8s-gitops checkout origin/main -- kustomize/overlays/prod scripts/smoke scripts/promotion release-candidates schema
ExecStart=/bin/bash /home/halil/platform/platform-k8s-gitops/scripts/smoke/d29-smoke-runner.sh prod
# Codex P0 follow-up — ledger marker for prod-side promotion record
ExecStartPost=/bin/bash -c 'latest=$(ls -t /tmp/smoke-report-prod-*.json 2>/dev/null | head -1); [[ -n "$latest" ]] && /bin/bash /home/halil/platform/platform-k8s-gitops/scripts/promotion/ledger-mark-verified.sh "$latest"'
StandardOutput=append:/var/log/platform-smoke-prod.log
StandardError=append:/var/log/platform-smoke-prod.log
TimeoutStartSec=300
SuccessExitStatus=0 1
