{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "endpoint-admin-service",
    "namespace": "platform-test",
    "labels": {
      "app.kubernetes.io/name": "endpoint-admin-service",
      "app.kubernetes.io/component": "backend",
      "app.kubernetes.io/part-of": "platform"
    }
  },
  "spec": {
    "replicas": 1,
    "selector": {"matchLabels": {"app.kubernetes.io/name": "endpoint-admin-service"}},
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "endpoint-admin-service",
          "app.kubernetes.io/part-of": "platform"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "serviceAccountName": "endpoint-admin-service",
        "containers": [
          {
            "name": "endpoint-admin-service",
            "image": "ghcr.io/halildeu/platform-backend-endpoint-admin-service@sha256:abc",
            "ports": [
              {"name": "http", "containerPort": 8096},
              {"name": "management", "containerPort": 8081}
            ],
            "livenessProbe": {
              "httpGet": {"path": "/healthz/live", "port": "management", "scheme": "HTTP"},
              "initialDelaySeconds": 15,
              "periodSeconds": 10,
              "timeoutSeconds": 1,
              "failureThreshold": 3,
              "successThreshold": 1
            },
            "readinessProbe": {
              "httpGet": {"path": "/healthz/ready", "port": "management", "scheme": "HTTP"},
              "initialDelaySeconds": 5,
              "periodSeconds": 5,
              "timeoutSeconds": 1,
              "failureThreshold": 6,
              "successThreshold": 1
            },
            "resources": {
              "requests": {"cpu": "100m", "memory": "128Mi"},
              "limits": {"cpu": "500m", "memory": "512Mi"}
            },
            "envFrom": [
              {"configMapRef": {"name": "endpoint-admin-service-config"}},
              {"secretRef": {"name": "endpoint-admin-service-secrets"}}
            ]
          }
        ]
      }
    }
  }
}
