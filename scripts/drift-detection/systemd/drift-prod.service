[Unit]
Description=Platform GitOps drift detection — prod cluster live state vs origin/main
Documentation=https://github.com/Halildeu/platform-k8s-gitops/blob/main/scripts/drift-detection/check_prod_drift.sh
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=halil
WorkingDirectory=/home/halil/platform/platform-k8s-gitops
ExecStartPre=/usr/bin/git -C /home/halil/platform/platform-k8s-gitops fetch origin main --quiet
ExecStartPre=/usr/bin/git -C /home/halil/platform/platform-k8s-gitops checkout origin/main -- kustomize/overlays/prod scripts/drift-detection
ExecStart=/bin/bash /home/halil/platform/platform-k8s-gitops/scripts/drift-detection/check_prod_drift.sh prod
StandardOutput=append:/var/log/platform-drift-prod.log
StandardError=append:/var/log/platform-drift-prod.log
TimeoutStartSec=120
# Non-zero exit => unit fails; failure logged + journalctl/log file retains report path
SuccessExitStatus=0
