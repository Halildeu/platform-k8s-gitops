[Unit]
Description=Platform GitOps drift detection — test cluster (lower cadence than prod)
Documentation=https://github.com/Halildeu/platform-k8s-gitops/blob/main/scripts/drift-detection/check_prod_drift.sh
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=halil
WorkingDirectory=/home/halil/platform/platform-k8s-gitops
ExecStartPre=/usr/bin/git -C /home/halil/platform/platform-k8s-gitops fetch origin main --quiet
ExecStartPre=/usr/bin/git -C /home/halil/platform/platform-k8s-gitops checkout origin/main -- kustomize/overlays/test scripts/drift-detection
ExecStart=/bin/bash /home/halil/platform/platform-k8s-gitops/scripts/drift-detection/check_prod_drift.sh test
ExecStartPost=/bin/bash -c 'latest=$(ls -t /tmp/drift-report-test-*.json 2>/dev/null | head -1); [[ -n "$latest" ]] && /bin/bash /home/halil/platform/platform-k8s-gitops/scripts/drift-detection/alarm_receiver.sh "$latest"'
StandardOutput=append:/var/log/platform-drift-test.log
StandardError=append:/var/log/platform-drift-test.log
TimeoutStartSec=180
SuccessExitStatus=0 1 2
