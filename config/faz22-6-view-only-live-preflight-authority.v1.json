        "ACTIVATED": ["CONSENT_PENDING", "FAILURE_CAPTURED", "ARTIFACTS_STAGE_FAILED"],
        "CONSENT_PENDING": ["EVIDENCE_COLLECTED", "FAILURE_CAPTURED", "ARTIFACTS_STAGE_FAILED"],
