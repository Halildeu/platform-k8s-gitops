{
  "schemaVersion": "acik.cross-ai-deployment-policy.v1",
  "policyId": "faz22-view-only-cross-ai-v1",
  "phase": "observe",
  "repositoryId": 1211415632,
  "repository": "Halildeu/platform-k8s-gitops",
  "environment": "faz22-view-only-pilot",
  "allowedApiOrigins": [
    "https://api.github.com"
  ],
  "allowedInstallationIds": [
    900000002
  ],
  "allowedDispatcherInstallationIds": [
    900000004
  ],
  "allowedDispatcherActorIds": [
    900000003
  ],
  "allowedDeploymentClasses": [
    "reversible-test"
