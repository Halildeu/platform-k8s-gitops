# iter-50 Step 3.4a — Self-hosted runner .env template.
#
# Bu dosyayı `.env` olarak kopyala ve değerleri doldur. `.env` dosyası
# `.gitignore`'a alınmalı (zaten gitops repo'nun kök `.gitignore`'unda
# `.env` exclude'u var).
#
# Codex 019dded6 ek sertleştirme:
#   --ephemeral runner her job sonrası deregister + exit. Static
#   `RUNNER_REGISTRATION_TOKEN` approach kırılır (token 1h, tek kullanımlık).
#   Doğru model: PAT verir, entrypoint API'den HER START'TA fresh token alır.

# Required: target repository
RUNNER_REPO=Halildeu/platform-k8s-gitops

# Required: fine-grained PAT for runner registration token endpoint
# Setup:
#   1. GitHub UI → Settings → Developer settings → Personal access tokens
#      → Fine-grained tokens → Generate new token
#   2. Repository access: Only select repositories → Halildeu/platform-k8s-gitops
#   3. Repository permissions:
#      - Administration: Write   (registration-token endpoint)
#      - Metadata: Read           (default, gerekli)
#   4. Token expiration: 1 yıl (veya policy'ye göre)
#   5. Token'ı kopyala → buraya yapıştır
#
# NOT: Bu PAT yalnız runner registration için. platform-web tarafının
# `GITOPS_DISPATCH_PAT`'ı AYRI bir PAT (Contents: Write scope, dispatch
# event endpoint için). Least-privilege ayrımı.
RUNNER_PAT=

# Optional: runner display name (GitHub UI'da Runners listesinde görünen)
RUNNER_NAME=staging-sw-testai-deploy

# Optional: labels (Codex 019dded6 S1 — tek amaçlı runner)
RUNNER_LABELS=self-hosted,staging-sw,testai-deploy

# Optional: runner group (Default genelde yeterli)
RUNNER_GROUP=Default

# Optional: GitHub API token fetch timeout/backoff.
# Keep bounded so an upstream egress outage does not create a tight container
# restart loop. RUNNER_PAT is passed through a transient curl config file, not
# curl command-line arguments.
RUNNER_GITHUB_API_CONNECT_TIMEOUT=5
RUNNER_GITHUB_API_MAX_TIME=20
RUNNER_TOKEN_RETRY_SECONDS=30
RUNNER_TOKEN_RETRY_MAX_SECONDS=300
RUNNER_TOKEN_CONFIG_TMPDIR=/dev/shm

# Optional: kubeconfig path on host (default: /home/halil/.kube/config)
HOST_KUBECONFIG=/home/halil/.kube/config
