{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acik.com/schemas/coordination-ledger-event-v1.schema.json",
  "title": "Coordination Ledger Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "event_uuid",
    "event_type",
    "writer_role",
    "committed_at",
    "previous_event_hash",
    "payload",
    "payload_hash",
    "event_hash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "coordination-ledger-event/v1"
    },
    "event_uuid": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "writer_role": {
      "type": "string",
      "minLength": 1
    },
    "committed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "previous_event_hash": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256Hash"
        }
      ]
    },
    "payload": {
      "type": "object"
    },
    "payload_hash": {
      "$ref": "#/$defs/sha256Hash"
    },
    "event_hash": {
      "$ref": "#/$defs/sha256Hash"
    },
    "key_id": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object"
        }
      ]
    },
    "comment_binding": {
      "$ref": "#/$defs/commentBinding"
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256Hash": {
      "type": "string",
      "pattern": "^(sha256:)?[a-f0-9]{64}$"
    },
    "commentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "repository",
        "issue",
        "comment_id",
        "author_id",
        "author_login",
        "author_type",
        "created_at",
        "updated_at",
        "raw_body_hash",
        "payload_hash",
        "verification_mode",
        "timestamp_tolerance_minutes"
      ],
      "properties": {
        "surface": {
          "const": "github_issue_comment"
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "comment_id": {
          "type": "integer",
          "minimum": 1
        },
        "author_id": {
          "type": "integer",
          "minimum": 1
        },
        "author_login": {
          "type": "string",
          "minLength": 1
        },
        "author_type": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "raw_body_hash": {
          "$ref": "#/$defs/sha256Hash"
        },
        "payload_hash": {
          "$ref": "#/$defs/sha256Hash"
        },
        "verification_mode": {
          "enum": [
            "normal",
            "degraded",
            "recovery"
          ]
        },
        "timestamp_tolerance_minutes": {
          "enum": [
            5,
            15
          ]
        }
      }
    }
  }
}
