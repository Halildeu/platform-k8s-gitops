# Faz 17.1 — Local dev environment variables template
# Copy to .env for local usage (gitignored).
# NO REAL CREDENTIALS HERE. All values are fake/dev-only.

# ===== Cluster =====
KUBECONFIG_CONTEXT=k3d-dev
PLATFORM_NAMESPACE=platform-dev

# ===== Edge =====
LOCAL_EDGE_HOST=app.localtest.me
LOCAL_EDGE_PORT=8443               # 17.X mkcert+Caddy fallback; sudo isterse 443

# ===== Keycloak (compose veya k3d içinde çalışabilir; bridge pattern kullanır) =====
KEYCLOAK_URL=http://keycloak.platform-dev.svc.cluster.local:8080
KEYCLOAK_REALM=dev-local
KEYCLOAK_CLIENT_ID=platform-gateway
KEYCLOAK_CLIENT_SECRET=dev-local-client-secret-NOT_FOR_PROD
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin      # Docker-compose kc container default

# ===== Postgres (host-bridge veya compose) =====
POSTGRES_HOST=postgres.platform-dev.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform-dev-NOT_FOR_PROD
POSTGRES_DB_AUTH=auth_db
POSTGRES_DB_USER=user_db
POSTGRES_DB_PERMISSION=permission_db
POSTGRES_DB_REPORTS=reports_db

# ===== Vault (opsiyonel, sadece full profile) =====
# VAULT_ADDR=http://vault.platform-dev.svc.cluster.local:8200
# VAULT_TOKEN=dev-root-token        # NEVER commit to git! Script sets this in env only.

# ===== OpenFGA =====
OPENFGA_API_URL=http://openfga.platform-dev.svc.cluster.local:8080
OPENFGA_STORE_ID=                  # dev-seed.sh script generate eder, post-seed update

# ===== Profile =====
# authn-min | zanzibar-min | full
LOCAL_PROFILE=authn-min

# ===== Image =====
# dev-up.sh k3d image import ile localhost registry kullanır
IMAGE_REGISTRY=registry.localhost:5002
IMAGE_TAG=dev-latest

# ===== Logging =====
LOG_LEVEL=DEBUG
SPRING_PROFILES_ACTIVE=k8s,dev
